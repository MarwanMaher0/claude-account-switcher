{
  "$schema": "https://anthropic.com/claude-code/plugin.schema.json",
  "name": "cc-switch",
  "displayName": "Claude Account Switcher",
  "version": "2.4.0",
  "description": "For Claude Code in the terminal and VS Code: run the Claude accounts you own side by side and move to the next when one hits its usage limit, keeping the conversation. Run /cc-setup after installing.",
  "author": {
    "name": "Marwan Maher",
    "email": "marwanmaher635@gmail.com",
    "url": "https://github.com/MarwanMaher0"
  },
  "homepage": "https://github.com/MarwanMaher0/claude-account-switcher",
  "repository": "https://github.com/MarwanMaher0/claude-account-switcher",
  "documentationUrl": "https://github.com/MarwanMaher0/claude-account-switcher/blob/main/README.md",
  "supportUrl": "https://github.com/MarwanMaher0/claude-account-switcher/issues",
  "privacyPolicyUrl": "https://github.com/MarwanMaher0/claude-account-switcher/blob/main/PRIVACY.md",
  "icon": "./docs/media/failover-square.png",
  "license": "MIT",
  "keywords": [
    "accounts",
    "multiple-accounts",
    "usage-limit",
    "rate-limit",
    "failover",
    "vscode"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 10,
            "statusMessage": "Checking account limits..."
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/limit-hit.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/limit-notice.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
