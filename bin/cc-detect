#!/usr/bin/env python3
"""Config, state and rate-limit detection for the `cc` account switcher.

Claude Code writes one JSON object per line into
  <config-dir>/projects/<slugified-cwd>/<session-id>.jsonl

A rate-limited turn carries a structured quota object:

  {"isApiErrorMessage": true, "apiErrorStatus": 429, "error": "rate_limit",
   "timestamp": "2026-09-12T19:15:37.908Z",
   "quotaLimits": {"status": "rejected", "rateLimitType": "seven_day",
                   "resetsAt": <epoch>}}

We key on quotaLimits.status == "rejected" and read resetsAt, rather than matching the
human-readable message, which is subject to change. rateLimitType names the window
that ran out ("five_hour", "seven_day", ...); it is displayed, never relied on.

Subcommands
  accounts                          one "<id>\\t<dir>\\t<isDefault>" per line, config order
  dir <id>                          that account's config directory
  is-default <id>                   exit 0 if it is the default account
  account-of [dir]                  "<id>\\t<isDefault>" for a config dir ($CLAUDE_CONFIG_DIR if omitted)
  emails                            "<id>\\t<email>" per account, email empty when not logged in
  duplicate-of <id>                 another account drawing on the same usage limit (exit 1 if none)
  pick                              account to start on: the preferred one if free, else the first free
  next-free [used,ids]              first free account in config order, skipping those listed
  soonest [exclude]                 "<id> <epoch>" for the limited account freeing up first
  status                            human-readable state, with live usage per account
  use <id>                          prefer this account for new sessions
  refresh                           learn limits hit outside cc (the VS Code panel, a bare claude)
  live [ids]                        ask Anthropic for each account's real usage and correct the
                                    recorded limits (all accounts when no ids are given)
  scan <dir> <session> [cwd] [offset]   "<resetsAt> [type]" if this run hit a limit
  size <dir> <session> [cwd]        transcript size, used as the scan offset
  session-limit <transcript> <id> <session> [own|recent]
                                    "<resetsAt> [type]" for a limit this session hit on <id>
  mark <id> <resets-at> [type]      set an account's limit window (0 clears)
  raise <id> <resets-at> [type]     extend an account's limit window, never shorten it
  record-run <id> <session>         note that a session has just started on an account
  slug <cwd>                        the project-dir slug for a path
  fallback <name> <field>           read a fallbacks.<name>.<field> value
  get <dotted.key> [default]        read any config value, e.g. autoContinue.message

Pinned folders (~/.claude-switch/pins.json)
  until <id>                        epoch the account's recorded limit ends (0: free)
  canon <path>                      the absolute, symlink-free form pins are compared in
  pin <path> <id> <switch|stop|ask> [fallback-id] [vscode 0|1]
                                    pin a folder and its subfolders to an account
  unpin <path>                      remove the pin on exactly that folder
  pins                              "<path>\\t<id>\\t<onLimit>\\t<fallback>\\t<vscode>" per pin
  pin-of [dir]                      the pin that applies to a directory (longest match)
  start-for [dir] [forced-id]       "use <id>", "switch <id>", "ask <id>", "stop <id>" or "none"
  bind <folder|-> [folder...] [--json|--shell]
                                    the account a VS Code window on these folders runs on.
                                    Fast and silent: no refresh, no live check. Exit 3 on a
                                    config error, 4 when cc is not set up, 5 on a timeout
  choose <dir> <account|stay|clear> answer an `ask` pin for VS Code until its limit passes
  fallback-for <dir> <id> [used,ids]
                                    after <id> hits its limit: "switch <id>", "ask <id>",
                                    "stop <id>" (pinned folder) or "none" (nothing left)

Usage percentage (opt-in early switch, read from Claude Code's own status line input)
  statusline <id> <session>         record rate_limits from stdin, then run the user's own
                                    status line command and print its output
  turn-ended                        Stop hook: note where this session's transcript ended
  early-settings <id> <session> <cwd>
                                    write the --settings file for an early-switch run
  early-check <id> <session> <transcript> [percent]
                                    "<resetsAt> <type>" once the account is past the
                                    threshold and this session is between turns

pick, next-free, soonest and status refresh first, so a limit hit in the VS Code panel
is known before the next launch. An account pinned to a folder is reserved for its
pins: pick and next-free never choose it outside them (the default account excepted).

Then they re-check, live, every account still recorded
as limited: a recorded window can be stale (the window rolled over early, the limit was
lifted), and a stale one keeps a usable account out of rotation — the way `cc` once
refused to start although an account had 99 % of its quota left.

The live check runs `claude -p /usage` as the account and reads the figures Claude Code
prints. No prompt reaches a model, so it spends no quota, and this tool itself still never
opens a credentials file or the network — Claude Code does the asking, and renews its own
login if it has to. Turn it off with CC_LIVE_CHECK=0 or "liveCheck": false in config.json.
"""
import fcntl
import glob
import json
import os
import re
import stat
import sys
import subprocess
import threading
import time
from contextlib import contextmanager
from datetime import datetime

try:
    from zoneinfo import ZoneInfo
except ImportError:                     # Python < 3.9
    ZoneInfo = None

HOME = os.path.expanduser("~")
SWITCH_DIR = os.path.join(HOME, ".claude-switch")
CONFIG = os.path.join(SWITCH_DIR, "config.json")
STATE = os.path.join(SWITCH_DIR, "state.json")
CACHE = os.path.join(SWITCH_DIR, "scan-cache.json")
PINS = os.path.join(SWITCH_DIR, "pins.json")
USAGE_DIR = os.path.join(SWITCH_DIR, "usage")
RUN_DIR = os.path.join(SWITCH_DIR, "run")
LOCK = os.path.join(SWITCH_DIR, ".lock")
DEFAULT_DIR = os.path.join(HOME, ".claude")
ID_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,31}$")
ON_LIMIT = ("switch", "stop", "ask")
DEFAULT_CONTINUE = "Continue where you left off."
DEFAULT_EARLY_PERCENT = 98

# A weekly window plus a margin: no older transcript or run can hold a live limit.
HORIZON = 8 * 86400
# How much of a transcript's end is read the first time it is seen. Nothing useful
# can follow a limit on the same account, so a live one sits near the end.
TAIL = 1024 * 1024

# Windows that stop every model. A model-scoped weekly window only blocks when it is the
# one a transcript already recorded as hit.
BLOCKING = ("five_hour", "seven_day")
# Automatic re-checks are skipped when the account was checked this recently, so hooks
# calling next-free and soonest back to back do not ask twice.
LIVE_TTL = 300
LIVE_TIMEOUT = 30

LIMIT_NAMES = {"five_hour": "5-hour", "seven_day": "weekly",
               "seven_day_opus": "weekly Opus", "seven_day_sonnet": "weekly Sonnet"}


class ConfigError(Exception):
    """Raised for any invalid config. Never swallowed — guessing which account to
    launch is how the wrong account gets written to."""


def expand(path):
    return os.path.abspath(os.path.expanduser(path))


def tilde(path):
    # Pins are stored with symlinks resolved, so also match the resolved home: on macOS
    # /var is a link to /private/var, and a home behind a symlink is common elsewhere.
    for home in (HOME, os.path.realpath(HOME)):
        if path == home or path.startswith(home + os.sep):
            return "~" + path[len(home):]
    return path


def slugify(path):
    """Claude Code's project-dir naming: non-alphanumerics become dashes."""
    return re.sub(r"[^A-Za-z0-9]", "-", os.path.abspath(path))


def _load_json(path, default):
    try:
        with open(path) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return default


def _write_private(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    os.chmod(os.path.dirname(path), 0o700)
    # per-process temp name: a hook and a launcher can write at the same moment
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as fh:
        json.dump(data, fh, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


@contextmanager
def state_lock():
    """Serialise read-modify-write of state.json. Hooks in several sessions and the
    launcher all record limits, and a lost update is a forgotten limit."""
    os.makedirs(SWITCH_DIR, exist_ok=True)
    fd = os.open(LOCK, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


# ---------------------------------------------------------------- config ----
def migrate():
    """Build config.json from the historical hardcoded two-account layout.

    Only ever runs when config.json is absent. Never touches account directories
    or credentials.
    """
    accounts = [{"id": "personal", "dir": "~/.claude", "isDefault": True}]
    second = os.path.join(HOME, ".claude-2")
    if os.path.isdir(second):
        accounts.append({"id": "account2", "dir": "~/.claude-2"})

    cfg = {
        "version": 2,
        "accounts": accounts,
        "fallbacks": {
            "apiKey": {"enabled": False, "keyCommand": None, "confirmEachUse": True},
            "externalCli": {"enabled": False, "command": None},
        },
    }
    _write_private(CONFIG, cfg)

    # Carry limit windows over from numeric keys.
    old = _load_json(STATE, {})
    old_accounts = old.get("accounts", {})
    if any(k.isdigit() for k in old_accounts):
        mapping = {"1": accounts[0]["id"]}
        if len(accounts) > 1:
            mapping["2"] = accounts[1]["id"]
        migrated = {}
        for num, new_id in mapping.items():
            if num in old_accounts:
                migrated[new_id] = {"limitedUntil": old_accounts[num].get("limitedUntil", 0)}
        save_state({"version": 2, "accounts": migrated})
    return cfg


def validate(cfg):
    accounts = cfg.get("accounts")
    if not isinstance(accounts, list) or not accounts:
        raise ConfigError("config has no accounts")

    # Count defaults up front: "two defaults" is the more fundamental mistake, and
    # reporting it beats the per-account dir error one of them would also trigger.
    marked = [a.get("id", "?") for a in accounts if a.get("isDefault")]
    if len(marked) > 1:
        raise ConfigError(f"more than one isDefault account: {', '.join(marked)}")

    seen_ids, seen_dirs = set(), set()
    for acct in accounts:
        aid = acct.get("id", "")
        if not ID_RE.match(aid or ""):
            raise ConfigError(f"invalid account id: {aid!r}")
        if aid in seen_ids:
            raise ConfigError(f"duplicate account id: {aid}")
        seen_ids.add(aid)

        if not acct.get("dir"):
            raise ConfigError(f"account {aid} has no dir")
        real = expand(acct["dir"])
        if real in seen_dirs:
            raise ConfigError(f"two accounts share a directory: {real}")
        seen_dirs.add(real)

        if acct.get("isDefault"):
            # The whole point of the flag: this account must be the one Claude
            # Code treats as default, or the launch environment will be wrong
            # and onboarding will overwrite its credentials.
            if real != expand(DEFAULT_DIR):
                raise ConfigError(
                    f"account {aid} is marked isDefault but its dir is {real}, "
                    f"not {DEFAULT_DIR}")

    return cfg


def load_config():
    if not os.path.exists(CONFIG):
        return validate(migrate())
    try:
        with open(CONFIG) as fh:
            cfg = json.load(fh)
    except OSError as exc:
        raise ConfigError(f"cannot read {CONFIG}: {exc}")
    except ValueError as exc:
        raise ConfigError(f"{CONFIG} is not valid JSON: {exc}")
    return validate(cfg)


def accounts():
    return load_config()["accounts"]


def account_by_id(aid):
    for acct in accounts():
        if acct["id"] == aid:
            return acct
    raise ConfigError(f"no such account: {aid}")


def account_of(config_dir):
    """The configured account a config dir belongs to. Unset means the default."""
    real = os.path.realpath(expand(config_dir) if config_dir else DEFAULT_DIR)
    for acct in accounts():
        if os.path.realpath(expand(acct["dir"])) == real:
            return acct
    return None


def account_oauth(acct):
    """The oauthAccount block Claude Code wrote at login, or {} when not signed in."""
    # The default account keeps its config at ~/.claude.json, BESIDE the directory.
    if acct.get("isDefault"):
        path = os.path.join(HOME, ".claude.json")
    else:
        path = os.path.join(expand(acct["dir"]), ".claude.json")
    data = _load_json(path, {})
    oauth = data.get("oauthAccount") if isinstance(data, dict) else None
    return oauth if isinstance(oauth, dict) else {}


def account_email(acct):
    return account_oauth(acct).get("emailAddress")


def same_limit_pool(a, b):
    """True when two configured accounts draw on one usage limit.

    That means the same account in the same organization. An email address alone is not
    enough: a personal plan and a work seat can share one address and still have separate
    limits, and refusing that pair would block exactly what this tool is for. Email is
    only the fallback when either login lacks the account and organization ids.
    """
    oa, ob = account_oauth(a), account_oauth(b)
    ids = ("accountUuid", "organizationUuid")
    if all(oa.get(k) for k in ids) and all(ob.get(k) for k in ids):
        return all(oa[k] == ob[k] for k in ids)
    ea = (oa.get("emailAddress") or "").lower()
    eb = (ob.get("emailAddress") or "").lower()
    return bool(ea) and ea == eb


# ----------------------------------------------------------------- state ----
def load_state():
    return _load_json(STATE, {"version": 2, "accounts": {}})


def save_state(state):
    _write_private(STATE, state)


def limited_until(state, aid):
    return int(state.get("accounts", {}).get(aid, {}).get("limitedUntil", 0) or 0)


def limit_type(state, aid):
    return state.get("accounts", {}).get(aid, {}).get("limitType")


def raise_limit(state, aid, resets, ltype=None):
    """Record a limit window, never shortening one already known. True if changed."""
    entry = state.setdefault("accounts", {}).setdefault(aid, {})
    resets = int(resets)
    if resets > limited_until(state, aid):
        entry["limitedUntil"] = resets
        if ltype:
            entry["limitType"] = ltype
        else:
            entry.pop("limitType", None)
        return True
    if resets == limited_until(state, aid) and ltype and not entry.get("limitType"):
        entry["limitType"] = ltype
        return True
    return False


def pick(state=None):
    """The preferred account if its window has passed, else the first free one in
    config order, else None. Accounts reserved for pinned folders are never picked."""
    state = state or load_state()
    now = time.time()
    preferred = state.get("preferred")
    reserved = reserved_ids()
    ordered = sorted(accounts(), key=lambda a: a["id"] != preferred)  # stable sort
    for acct in ordered:
        if acct["id"] in reserved:
            continue
        if limited_until(state, acct["id"]) <= now:
            return acct["id"]
    return None


def next_free(state=None, exclude=()):
    """First free, unreserved account in config order, skipping `exclude`."""
    state = state or load_state()
    now = time.time()
    reserved = reserved_ids()
    for acct in accounts():
        aid = acct["id"]
        if aid in exclude or aid in reserved:
            continue
        if limited_until(state, aid) <= now:
            return aid
    return None


# ------------------------------------------------------------------ pins ----
# A pin ties a folder, and everything under it, to one account. It exists to keep
# separate employers' work apart, so every rule here fails closed: a pin naming an
# account that no longer exists is an error, never a silent move to another account,
# and a pinned account may only fall back to an account that is not itself pinned.
def canon(path):
    """Absolute, `~`-expanded, symlink-free: the one form pins are compared in."""
    return os.path.realpath(expand(path or os.getcwd()))


def load_pins():
    data = _load_json(PINS, {})
    pins = data.get("pins") if isinstance(data, dict) else None
    return [p for p in pins if isinstance(p, dict) and p.get("path")] if isinstance(pins, list) else []


def save_pins(pins):
    _write_private(PINS, {"version": 1, "pins": sorted(pins, key=lambda p: p["path"])})


def default_id():
    return next((a["id"] for a in accounts() if a.get("isDefault")), None)


def reserved_ids(pins=None):
    """Accounts kept for their pinned folders. The default account is never reserved:
    it is what every unpinned folder runs on."""
    pins = load_pins() if pins is None else pins
    return {p.get("account") for p in pins} - {default_id(), None}


def pin_for(path):
    """The pin that applies to `path`: the longest pinned folder containing it."""
    real = canon(path)
    best = None
    for pin in load_pins():
        root = pin["path"]
        if real == root or real.startswith(root.rstrip(os.sep) + os.sep):
            if best is None or len(root) > len(best["path"]):
                best = pin
    return best


def check_pin(pin):
    """Raise ConfigError unless a stored pin can be acted on."""
    ids = {a["id"] for a in accounts()}
    if pin.get("account") not in ids:
        raise ConfigError(f"{tilde(pin['path'])} is pinned to '{pin.get('account')}', which is not "
                          f"a configured account. Run: cc pin {tilde(pin['path'])}  (or cc unpin)")
    if pin.get("onLimit") not in ON_LIMIT:
        raise ConfigError(f"pin on {tilde(pin['path'])} has an invalid onLimit: {pin.get('onLimit')!r}")
    if pin["onLimit"] != "stop" and pin.get("fallback") not in ids:
        raise ConfigError(f"pin on {tilde(pin['path'])} falls back to unknown account "
                          f"'{pin.get('fallback')}'")


def set_pin(path, aid, on_limit, fallback=None, vscode=True):
    """Add or replace the pin on `path`. Enforces: no pinned account is ever another
    pin's fallback, which is what keeps one employer's account out of another's work."""
    account_by_id(aid)
    if on_limit not in ON_LIMIT:
        raise ConfigError(f"on a limit, a pin can switch, stop or ask — not {on_limit!r}")
    if on_limit == "stop":
        fallback = None
    else:
        if not fallback:
            raise ConfigError(f"'{on_limit}' needs an account to fall back to")
        account_by_id(fallback)
        if fallback == aid:
            raise ConfigError("an account cannot be its own fallback")
    root = canon(path)
    if not os.path.isdir(root):
        raise ConfigError(f"not a folder: {path}")
    dflt = default_id()
    with state_lock():
        pins = [p for p in load_pins() if p["path"] != root]
        pinned = {p["account"] for p in pins} | {aid}
        if fallback and fallback != dflt and fallback in pinned:
            raise ConfigError(f"'{fallback}' is pinned to its own folders, so it cannot be a "
                              f"fallback here. Fall back to '{dflt}' or stop at the limit.")
        if aid != dflt:
            users = sorted(tilde(p["path"]) for p in pins if p.get("fallback") == aid)
            if users:
                raise ConfigError(f"'{aid}' is the fallback for {', '.join(users)}, so it cannot "
                                  f"also be pinned. Change those pins first.")
        pins.append({"path": root, "account": aid, "onLimit": on_limit,
                     "fallback": fallback, "vscode": bool(vscode)})
        save_pins(pins)
    return root


def remove_pin(path):
    root = canon(path)
    with state_lock():
        pins = load_pins()
        kept = [p for p in pins if p["path"] != root]
        if len(kept) == len(pins):
            return None
        save_pins(kept)
    return root


def free(state, aid, now=None):
    return limited_until(state, aid) <= (time.time() if now is None else now)


def start_for(path, forced=None):
    """Which account a session started in `path` runs on, as (verb, id).

    use    — run on <id>
    switch — the pinned account is limited; its rule moves this session to <id>
    ask    — the pinned account is limited; ask before moving to <id>
    stop   — the pinned account <id> is limited and nothing else is allowed
    none   — unpinned and every account is limited (the paid tiers may follow)
    """
    if forced:
        account_by_id(forced)
        return "use", forced
    pin = pin_for(path)
    if not pin:
        aid = pick()
        return ("use", aid) if aid else ("none", "")
    check_pin(pin)
    state = load_state()
    if free(state, pin["account"]):
        return "use", pin["account"]
    return limit_rule(state, pin, ())


def limit_rule(state, pin, used):
    """What a pinned folder's rule allows once its account is limited."""
    fb = pin.get("fallback")
    if pin["onLimit"] != "stop" and fb and fb not in used and free(state, fb):
        return pin["onLimit"], fb
    return "stop", pin["account"]


def fallback_for(path, aid, used=()):
    """Where a session in `path` goes after `aid` hits its limit, as (verb, id).

    In a pinned folder the pin decides, and the only move is to its fallback: once
    there, a second limit stops. Unpinned folders keep the original rotation over the
    accounts not reserved for pins.
    """
    used = set(used) | {aid}
    state = load_state()
    pin = pin_for(path)
    if pin:
        check_pin(pin)
        if aid != pin["account"]:
            return "stop", aid
        return limit_rule(state, pin, used)
    nxt = next_free(state, used)
    return ("switch", nxt) if nxt else ("none", "")


# ------------------------------------------------------------------ bind ----
# `bind` is the decision for a VS Code window, made by the process wrapper on every
# Claude spawn and by the companion extension when a window opens or cc's state
# changes. It has to be fast and silent: no refresh, no live check, no lock, nothing
# read from stdin. It reads config.json, pins.json and state.json, which the hooks and
# the launcher keep current.
class NotSetUp(Exception):
    """cc has never been configured on this machine."""


def fallback_choice(state, pin, now):
    """The choice stored for an `ask` pin while its account is limited: the account to
    use, or None. A choice lasts until the limit it was made for has passed."""
    chosen = (state.get("fallbackChosen") or {}).get(pin["path"])
    if not isinstance(chosen, dict):
        return None
    until = int(chosen.get("until") or 0)
    # Made for an earlier limit (the account was free in between, then ran out again):
    # that answer does not carry over, so ask again.
    if until <= now or until < limited_until(state, pin["account"]):
        return None
    return chosen.get("account") or None


def bind_one(folder, state, now):
    """The account a VS Code window on `folder` runs on, as a dict (see `bind`)."""
    ids = {a["id"]: a for a in accounts()}
    pin = pin_for(folder) if folder else None
    if pin is not None and pin.get("vscode") is False:
        pin = None                           # a terminal-only pin: the window is unpinned
    res = {"folder": canon(folder) if folder else None, "pinned": pin is not None,
           "pin": pin["path"] if pin else None, "fallback": None, "limitedUntil": 0,
           "choice": None}
    if pin is not None:
        check_pin(pin)
        pa = pin["account"]
        res["fallback"] = pin.get("fallback")
        res["limitedUntil"] = limited_until(state, pa) if not free(state, pa, now) else 0
        if free(state, pa, now):
            verb, aid, reason = "use", pa, f"pinned to {pa}"
        else:
            rule, aid = limit_rule(state, pin, ())
            until = fmt_until(limited_until(state, pa), now)
            if rule == "switch":
                verb, reason = "switch", f"{pa} is limited until {until}; the pin falls back to {aid}"
            elif rule == "ask":
                verb = "ask"
                chosen = fallback_choice(state, pin, now)
                if chosen == aid:
                    res["choice"] = "fallback"
                    reason = f"{pa} is limited until {until}; {aid} was chosen for this pin"
                elif chosen == pa:
                    res["choice"] = "stay"
                    aid, reason = pa, f"{pa} is limited until {until}; staying was chosen"
                else:
                    aid, reason = pa, f"{pa} is limited until {until}; the pin asks before using {aid}"
            else:
                verb, reason = "stop", f"{pa} is limited until {until} and the pin allows nothing else"
    else:
        aid = pick(state)
        if aid:
            verb, reason = "use", "not pinned"
        else:
            # Nothing unpinned is free. Run on the preferred unpinned account anyway, so
            # Claude itself shows the limit, rather than failing the window.
            reserved = reserved_ids()
            usable = [a["id"] for a in accounts() if a["id"] not in reserved]
            if not usable:
                raise ConfigError("every account is pinned to a folder, so an unpinned "
                                  "folder has no account to run on")
            preferred = state.get("preferred")
            aid = preferred if preferred in usable else usable[0]
            verb, reason = "none", "not pinned, and every unpinned account is limited"
    acct = ids[aid]
    adir = expand(acct["dir"])
    unset = bool(acct.get("isDefault")) or os.path.realpath(adir) == os.path.realpath(DEFAULT_DIR)
    res.update({"verb": verb, "account": aid, "dir": "" if unset else adir, "unset": unset,
                "isDefault": bool(acct.get("isDefault")), "reason": reason})
    # When this decision can next change on its own: the earliest limit, among the
    # accounts it depends on, that is still running.
    watch = [a for a in (pin["account"], pin.get("fallback")) if a] if pin else list(ids)
    ends = [limited_until(state, a) for a in watch if limited_until(state, a) > now]
    res["recheckAt"] = min(ends) if ends else 0
    return res


def bind(folders):
    """The decision for a window with these workspace folders. The first folder decides,
    as it does for the Claude extension; `mixed` is set when the folders fall under
    different pinned accounts."""
    if not os.path.exists(CONFIG):
        if load_pins():
            raise ConfigError(f"{PINS} exists but {CONFIG} does not")
        raise NotSetUp("cc is not set up on this machine")
    if os.path.exists(PINS):
        try:
            with open(PINS) as fh:
                json.load(fh)
        except (OSError, ValueError) as exc:
            # A pins file that cannot be read must not look like "no pins".
            raise ConfigError(f"cannot read {PINS}: {exc}")
    state = load_state()
    now = time.time()
    rows = [bind_one(None if f in ("-", "") else f, state, now) for f in (folders or ["-"])]
    out = dict(rows[0])
    owners = {r["pin"] and pin_account(r["pin"]) for r in rows}
    out["mixed"] = len(owners) > 1
    out["folders"] = rows
    out["recheckAt"] = min([r["recheckAt"] for r in rows if r["recheckAt"]] or [0])
    out["configured"] = True
    return out


def pin_account(path):
    return next((p.get("account") for p in load_pins() if p["path"] == path), None)


def soonest(state=None, exclude=()):
    """Of the accounts that are actually limited, the one freeing up first.

    Only accounts whose window is still in the future count. An available account
    has limitedUntil 0, so including them would always win the min() and report a
    reset time of the epoch — which is how this was wrong the first time.
    """
    state = state or load_state()
    now = time.time()
    reserved = reserved_ids()
    candidates = [a["id"] for a in accounts()
                  if a["id"] not in exclude and a["id"] not in reserved
                  and limited_until(state, a["id"]) > now]
    if not candidates:
        return None, 0
    aid = min(candidates, key=lambda i: limited_until(state, i))
    return aid, limited_until(state, aid)


# ------------------------------------------------------------------ runs ----
def record_run(aid, session):
    now = time.time()
    with state_lock():
        state = load_state()
        runs = [r for r in state.get("runs", []) if r.get("startedAt", 0) > now - HORIZON]
        runs.append({"session": session, "account": aid, "startedAt": int(now)})
        state["runs"] = runs[-1000:]
        save_state(state)


def latest_run(runs, session, aid=None, before=None):
    """The most recent recorded run of a session, optionally on one account or
    started no later than a moment (with two seconds of clock slack)."""
    best = None
    for run in runs:
        if run.get("session") != session:
            continue
        if aid is not None and run.get("account") != aid:
            continue
        started = run.get("startedAt", 0)
        if before is not None and started > before + 2:
            continue
        if best is None or started >= best.get("startedAt", 0):
            best = run
    return best


# ------------------------------------------------------------ transcripts ----
def transcript_path(config_dir, session_id, cwd=None):
    proj = os.path.join(expand(config_dir), "projects", slugify(cwd or os.getcwd()))
    return os.path.join(proj, f"{session_id}.jsonl")


def size_of(config_dir, session_id, cwd=None):
    try:
        return os.path.getsize(transcript_path(config_dir, session_id, cwd))
    except OSError:
        return 0


def parse_ts(value):
    """Epoch seconds from a transcript timestamp such as 2026-09-12T19:15:37.908Z."""
    if not value:
        return None
    try:
        return datetime.fromisoformat(str(value).replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def limit_events(chunk, now=None):
    """Unexpired usage-limit events in a block of transcript bytes."""
    now = time.time() if now is None else now
    found = []
    for line in chunk.split(b"\n"):
        if b'"quotaLimits"' not in line or b'"rejected"' not in line:   # cheap prefilter
            continue
        try:
            obj = json.loads(line)
        except ValueError:
            continue                        # partial first line from a tail seek
        quota = obj.get("quotaLimits") if isinstance(obj, dict) else None
        if not isinstance(quota, dict) or quota.get("status") != "rejected":
            continue
        resets = quota.get("resetsAt")
        # An event whose window has already elapsed is history, not a reason to
        # switch — otherwise an old limit in the tail triggers a handoff on every
        # later exit.
        if not isinstance(resets, (int, float)) or resets <= now:
            continue
        found.append({"uuid": obj.get("uuid"), "resetsAt": int(resets),
                      "type": quota.get("rateLimitType"),
                      "ts": parse_ts(obj.get("timestamp"))})
    return found


def scan(config_dir, session_id, cwd=None, offset=0):
    """The limit event THIS RUN hit (latest reset), else None.

    `offset` is the transcript's byte size captured just before the run started, so
    only newly appended turns count. This matters after a handoff: the transcript
    copied from the limited account still contains that account's 429, and without
    the offset the receiving account would re-read it and mark itself limited too.
    """
    path = transcript_path(config_dir, session_id, cwd)
    cap = 64 * 1024 * 1024  # never scan more than this, however long the run
    try:
        with open(path, "rb") as fh:
            size = fh.seek(0, os.SEEK_END)
            fh.seek(max(int(offset or 0), size - cap, 0))
            chunk = fh.read()
    except OSError:
        return None
    events = limit_events(chunk)
    return max(events, key=lambda e: e["resetsAt"]) if events else None


def session_limit(path, since):
    """Newest limit event in a transcript written at or after `since`."""
    try:
        with open(path, "rb") as fh:
            size = fh.seek(0, os.SEEK_END)
            fh.seek(max(0, size - 8 * TAIL))
            chunk = fh.read()
    except OSError:
        return None
    events = [e for e in limit_events(chunk) if e["ts"] is not None and e["ts"] >= since - 2]
    return max(events, key=lambda e: e["ts"]) if events else None


def _events_for(path, st, entry, now):
    """Limit events in one transcript, reading only what was appended since the
    last look. Returns (events, cache entry)."""
    resuming = bool(entry) and entry.get("ino") == st.st_ino and st.st_size >= entry.get("size", 0)
    if resuming and st.st_size == entry.get("size"):
        events = [e for e in entry.get("events", []) if e["resetsAt"] > now]
        return events, dict(entry, events=events)

    start = entry["size"] if resuming else max(0, st.st_size - TAIL)
    try:
        with open(path, "rb") as fh:
            fh.seek(start)
            raw = fh.read(st.st_size - start)
    except OSError:
        return [], None

    body = 0
    if start > 0 and not resuming:          # a tail read lands mid-line
        nl = raw.find(b"\n")
        body = nl + 1 if nl >= 0 else len(raw)
    end = max(raw.rfind(b"\n") + 1, body)   # stop after the last complete line
    events = (entry.get("events", []) if resuming else []) + limit_events(raw[body:end], now)
    events = [e for e in events if e["resetsAt"] > now]
    return events, {"ino": st.st_ino, "size": start + end, "events": events}


def refresh():
    """Learn limits hit outside `cc` — in the VS Code panel or a bare `claude` — from
    every account's recent transcripts, and record them in state.

    Attribution is the hard part. Conversations are copied or linked between
    accounts when they move, so a limit event can sit in a directory that does not
    own it. An event is pinned on:
      1. the account of the latest recorded run of that session that started before
         the event (cc and the plugin's SessionStart hook record runs); otherwise
      2. the only account whose copy of that session holds the event.
    Anything still ambiguous is skipped. A missed limit costs one extra 429; a
    wrong one would keep a healthy account out of rotation.
    """
    now = time.time()
    accts = accounts()
    ids = {a["id"] for a in accts}
    old = _load_json(CACHE, {})
    if not isinstance(old, dict):
        old = {}
    cache, holders, candidates = {}, {}, []

    for acct in accts:
        pattern = os.path.join(glob.escape(expand(acct["dir"])), "projects", "*", "*.jsonl")
        for path in glob.glob(pattern):
            try:
                st = os.lstat(path)
            except OSError:
                continue
            if not stat.S_ISREG(st.st_mode) or st.st_mtime < now - HORIZON:
                continue
            events, entry = _events_for(path, st, old.get(path), now)
            if entry is not None:
                cache[path] = entry
            session = os.path.basename(path)[:-len(".jsonl")]
            for ev in events:
                holders.setdefault((session, ev["uuid"]), set()).add(acct["id"])
                candidates.append((session, ev))

    if cache != old:
        _write_private(CACHE, cache)
    if not candidates:
        return

    with state_lock():
        state = load_state()
        runs = state.get("runs", [])
        changed = False
        for session, ev in candidates:
            run = latest_run(runs, session, before=ev["ts"]) if ev["ts"] else None
            owner = run.get("account") if run else None
            if owner is None and ev["uuid"]:
                held = holders.get((session, ev["uuid"]), set())
                owner = next(iter(held)) if len(held) == 1 else None
            if owner in ids and not _superseded(state, owner, ev):
                changed = raise_limit(state, owner, ev["resetsAt"], ev["type"]) or changed
        if changed:
            save_state(state)


# ------------------------------------------------------------ live usage ----
class LiveError(Exception):
    """Why an account's usage could not be read. Shown, never fatal."""


def _superseded(state, aid, ev):
    """True when a live check made after this limit event found the account usable.

    Without this, the transcript that recorded the old 429 would put the stale window
    straight back on the next refresh — the event stays "unexpired" until its resetsAt.
    """
    checked = state.get("accounts", {}).get(aid, {}).get("liveCheckedAt", 0)
    if not checked:
        return False
    return ev["ts"] is None or ev["ts"] <= checked


def live_enabled():
    # CC_LIVE_PROBE marks the probe's own claude process: its SessionStart hook calls
    # next-free, which must not probe again.
    if os.environ.get("CC_LIVE_PROBE"):
        return False
    if os.environ.get("CC_LIVE_CHECK", "1") in ("0", "false", "no", "off"):
        return False
    try:
        return load_config().get("liveCheck", True) is not False
    except ConfigError:
        return False


# "Current session: 12% used · resets Sep 24, 1:50pm (Africa/Cairo)"
# "Current week (all models): 17% used · resets Sep 29, 4pm (Africa/Cairo)"
USAGE_LINE = re.compile(r"^\s*Current (session|week)(?: \(([^)]+)\))?:\s*(\d+(?:\.\d+)?)% used"
                        r"(?:\s*·\s*resets\s+(.+?))?\s*$")


def _window_name(kind, scope):
    if kind == "session":
        return "five_hour"
    if not scope or scope.lower() == "all models":
        return "seven_day"
    return "seven_day_" + re.sub(r"[^a-z0-9]+", "_", scope.lower()).strip("_")


def parse_reset(text, now=None):
    """Epoch for "Sep 24, 1:50pm (Africa/Cairo)", "Sep 28, 7am" or "1:50pm"; 0 if unreadable."""
    now = time.time() if now is None else now
    m = re.match(r"^(.*?)\s*(?:\(([^)]+)\))?$", text.strip())
    body, zone = m.group(1).strip(), m.group(2)
    tz = None
    if zone and ZoneInfo:
        try:
            tz = ZoneInfo(zone)
        except Exception:
            tz = None
    ref = datetime.fromtimestamp(now, tz)
    for fmt in ("%b %d, %I:%M%p", "%b %d, %I%p", "%I:%M%p", "%I%p"):
        try:
            parsed = datetime.strptime(body, fmt)     # %b and %p match case-insensitively
        except ValueError:
            continue
        if "%b" in fmt:
            dt = parsed.replace(year=ref.year, tzinfo=tz)
            if dt.timestamp() < now - 86400:        # "Jan 2" read in late December
                dt = dt.replace(year=ref.year + 1)
        else:
            dt = ref.replace(hour=parsed.hour, minute=parsed.minute, second=0, microsecond=0)
            if dt.timestamp() < now - 60:
                dt = datetime.fromtimestamp(dt.timestamp() + 86400, tz)
        return int(dt.timestamp())
    return 0


def parse_usage(text, now=None):
    usage = {}
    for line in text.splitlines():
        m = USAGE_LINE.match(line)
        if m:
            kind, scope, pct, resets = m.groups()
            usage[_window_name(kind, scope)] = {
                "pct": float(pct), "resetsAt": parse_reset(resets, now) if resets else 0}
    return usage


def fetch_usage(acct):
    """The account's usage windows as {window: {"pct": n, "resetsAt": epoch}}.

    Launched exactly as `cc` launches the account: the default one with CLAUDE_CONFIG_DIR
    removed, never set to its own path (see run_acct in cc).
    """
    env = dict(os.environ, CC_LIVE_PROBE="1")
    if acct.get("isDefault"):
        env.pop("CLAUDE_CONFIG_DIR", None)
    else:
        env["CLAUDE_CONFIG_DIR"] = expand(acct["dir"])
    os.makedirs(SWITCH_DIR, exist_ok=True)
    try:
        res = subprocess.run(["claude", "-p", "/usage", "--no-session-persistence", "--strict-mcp-config"],
                             env=env, cwd=SWITCH_DIR, stdin=subprocess.DEVNULL,
                             capture_output=True, text=True, timeout=LIVE_TIMEOUT)
    except FileNotFoundError:
        raise LiveError("claude is not on PATH") from None
    except subprocess.TimeoutExpired:
        raise LiveError(f"claude /usage did not answer in {LIVE_TIMEOUT} s") from None
    usage = parse_usage(res.stdout)
    if not usage:
        said = next((ln.strip() for ln in (res.stdout + res.stderr).splitlines() if ln.strip()), "")
        raise LiveError(f"no usage figures from claude /usage{': ' + said[:80] if said else ''}")
    return usage


def live_limit(usage, recorded_type=None, now=None):
    """(resetsAt, type) for the latest-ending exhausted window, or (0, None)."""
    now = time.time() if now is None else now
    names = list(BLOCKING)
    if recorded_type and recorded_type not in names:
        names.append(recorded_type)
    # An exhausted window whose reset time could not be read still counts: assume half an
    # hour and let the next check correct it, rather than launch into a certain 429.
    hits = [(w["resetsAt"] if w["resetsAt"] > now else int(now) + 1800, n) for n in names
            for w in [usage.get(n)] if w and w["pct"] >= 100]
    return max(hits) if hits else (0, None)


def live_check(ids=None, force=False):
    """Ask Anthropic for the real usage of some accounts and correct the state.

    Unlike `raise`, this may SHORTEN or CLEAR a recorded window: the server's answer is
    authoritative, a transcript is only a past observation. Returns {id: usage or
    LiveError}. Accounts checked in the last LIVE_TTL seconds are skipped unless forced.
    """
    state, now = load_state(), time.time()
    targets = [a for a in accounts() if ids is None or a["id"] in ids]
    if not force:
        targets = [a for a in targets
                   if now - state.get("accounts", {}).get(a["id"], {}).get("liveCheckedAt", 0) > LIVE_TTL]
    results = {}

    def one(acct):
        try:
            results[acct["id"]] = fetch_usage(acct)
        except LiveError as exc:
            results[acct["id"]] = exc

    threads = [threading.Thread(target=one, args=(a,), daemon=True) for a in targets]
    for t in threads:
        t.start()
    for t in threads:
        t.join(LIVE_TIMEOUT + 2)

    fresh = {aid: u for aid, u in results.items() if isinstance(u, dict)}
    if fresh:
        with state_lock():
            state, now = load_state(), time.time()
            for aid, usage in fresh.items():
                entry = state.setdefault("accounts", {}).setdefault(aid, {})
                resets, ltype = live_limit(usage, entry.get("limitType"), now)
                entry["usage"] = usage
                entry["liveCheckedAt"] = int(now)
                if resets:
                    entry["limitedUntil"] = resets
                    entry["limitType"] = ltype
                else:
                    entry["limitedUntil"] = 0
                    entry.pop("limitType", None)
            save_state(state)
    return results


def _verify_limited():
    """Re-check, live, the accounts the state says are limited. Quiet on failure."""
    if not live_enabled():
        return
    state, now = load_state(), time.time()
    limited = {a["id"] for a in accounts() if limited_until(state, a["id"]) > now}
    if limited:
        live_check(limited)


def _refresh_quietly():
    try:
        refresh()
    except ConfigError:
        raise
    except Exception as exc:  # bookkeeping must never stop a launch
        print(f"cc-detect: could not read transcripts for limits: {exc}", file=sys.stderr)
    try:
        _verify_limited()
    except ConfigError:
        raise
    except Exception as exc:
        print(f"cc-detect: live usage check failed: {exc}", file=sys.stderr)


# ----------------------------------------------------------------- usage ----
# Claude Code hands its status line command the rate-limit usage it already received
# with each API response (rate_limits.five_hour / seven_day: used_percentage and
# resets_at, for Pro and Max plans). Recording that is the only local source of a
# usage percentage: no file on disk holds it, and asking the API ourselves would be a
# network call this tool does not make. So the early switch is opt-in and rides on
# the status line, and when the data is absent cc simply switches at the real limit.
def config_get(dotted, default=None):
    node = load_config()
    for part in dotted.split("."):
        if not isinstance(node, dict) or part not in node:
            return default
        node = node[part]
    return node


def early_percent():
    try:
        pct = float(config_get("earlySwitch.percent", DEFAULT_EARLY_PERCENT))
    except (TypeError, ValueError):
        pct = DEFAULT_EARLY_PERCENT
    return min(max(pct, 1.0), 100.0)


def usage_path(aid):
    return os.path.join(USAGE_DIR, f"{aid}.json")


def record_usage(aid, payload, now=None):
    """Keep the rate-limit windows from one status line input. Returns True if any."""
    now = time.time() if now is None else now
    limits = payload.get("rate_limits") if isinstance(payload, dict) else None
    windows = {}
    for name, win in (limits.items() if isinstance(limits, dict) else ()):
        if not isinstance(win, dict) or name == "spend_limit":
            continue
        pct, resets = win.get("used_percentage"), win.get("resets_at")
        if isinstance(pct, (int, float)) and isinstance(resets, (int, float)) and resets > now:
            windows[name] = {"usedPercentage": float(pct), "resetsAt": int(resets)}
    if not windows:
        return False
    # one writer per status line refresh, atomic replace: sessions on the same account
    # may overwrite each other, and each one's reading is as good as the other's
    _write_private(usage_path(aid), {"at": int(now), "windows": windows})
    return True


def usage_over(aid, percent, now=None):
    """(resetsAt, window) of the account's window at or past `percent`, else None."""
    now = time.time() if now is None else now
    data = _load_json(usage_path(aid), {})
    windows = data.get("windows") if isinstance(data, dict) else None
    hits = [(w["resetsAt"], name) for name, w in (windows or {}).items()
            if isinstance(w, dict) and w.get("resetsAt", 0) > now
            and w.get("usedPercentage", 0) >= percent]
    return max(hits) if hits else None


def marker_path(session):
    return os.path.join(RUN_DIR, f"{session}.turn")


def turn_ended(payload):
    """Stop hook: remember where the transcript ended when Claude finished a turn."""
    session = payload.get("session_id") if isinstance(payload, dict) else None
    transcript = payload.get("transcript_path") if isinstance(payload, dict) else None
    if not session or not transcript:
        return
    try:
        size = os.path.getsize(transcript)
    except OSError:
        return
    _write_private(marker_path(session), {"offset": size, "at": int(time.time())})


def between_turns(session, transcript):
    """True when the last turn has ended and nothing has started since.

    Every new turn — a typed prompt, a queued one, a tool result — is written as a
    "user" line, so none after the Stop marker means Claude is waiting for the user.
    Ending the run there cuts nothing.
    """
    marker = _load_json(marker_path(session), None)
    if not isinstance(marker, dict):
        return False
    try:
        with open(transcript, "rb") as fh:
            fh.seek(int(marker.get("offset", 0)))
            tail = fh.read()
    except OSError:
        return False
    for line in tail.split(b"\n"):
        if b'"user"' not in line:
            continue
        try:
            if json.loads(line).get("type") == "user":
                return False
        except (ValueError, AttributeError):
            continue
    return True


def early_settings(aid, session, cwd, detect_path):
    """Write the --settings file an early-switch run starts with. The user's own status
    line, if any, still runs and prints: ours records usage and hands over to it."""
    own = None
    acct = account_by_id(aid)
    sources = [os.path.join(cwd, ".claude", "settings.local.json"),
               os.path.join(cwd, ".claude", "settings.json"),
               os.path.join(expand(acct["dir"]), "settings.json")]
    for src in sources:
        data = _load_json(src, {})
        line = data.get("statusLine") if isinstance(data, dict) else None
        if isinstance(line, dict) and line.get("command"):
            own = line
            break
    os.makedirs(RUN_DIR, exist_ok=True)
    if own:
        with open(os.path.join(RUN_DIR, f"{session}.next"), "w") as fh:
            fh.write(own["command"])
    quoted = "'" + detect_path.replace("'", "'\\''") + "'"
    status = {"type": "command", "command": f"{quoted} statusline {aid} {session}"}
    if own and own.get("padding") is not None:
        status["padding"] = own["padding"]
    settings = {
        "statusLine": status,
        "hooks": {"Stop": [{"hooks": [{"type": "command", "command": f"{quoted} turn-ended",
                                       "timeout": 10}]}]},
    }
    path = os.path.join(RUN_DIR, f"{session}.settings.json")
    _write_private(path, settings)
    return path


def run_statusline(aid, session, raw):
    try:
        record_usage(aid, json.loads(raw or "{}"))
    except (ValueError, OSError):
        pass                                 # the status line must keep printing
    try:
        with open(os.path.join(RUN_DIR, f"{session}.next")) as fh:
            own = fh.read().strip()
    except OSError:
        own = ""
    if own:
        import subprocess
        try:
            res = subprocess.run(own, shell=True, input=raw, capture_output=True,
                                 text=True, timeout=10)
            sys.stdout.write(res.stdout)
        except (OSError, subprocess.SubprocessError):
            pass


# ------------------------------------------------------------------ main ----
def fmt_until(epoch, now):
    """Clock time, with the weekday once the reset is more than 20 hours away."""
    fmt = "%H:%M" if epoch - now < 20 * 3600 else "%a %H:%M"
    return time.strftime(fmt, time.localtime(epoch))


def fmt_left(seconds):
    minutes = int(seconds // 60)
    if minutes < 60:
        return f"{minutes} min"
    hours, minutes = divmod(minutes, 60)
    if hours < 24:
        return f"{hours} h {minutes} min"
    days, hours = divmod(hours, 24)
    return f"{days} d {hours} h"


SHORT = {"five_hour": "5h", "seven_day": "wk", "seven_day_opus": "wk-opus",
         "seven_day_sonnet": "wk-sonnet"}


def fmt_usage(entry, now):
    """"5h 12% · wk 3%  (2 min ago)" from the last live check, or "" if there was none."""
    usage, checked = entry.get("usage") or {}, entry.get("liveCheckedAt", 0)
    names = sorted(usage, key=lambda n: (n not in SHORT, list(SHORT).index(n) if n in SHORT else 0, n))
    parts = [f"{SHORT.get(n, 'wk-' + n[len('seven_day_'):])} {usage[n]['pct']:.0f}%" for n in names]
    if not parts:
        return ""
    age = now - checked
    when = "just now" if age < 60 else f"{fmt_left(age)} ago"
    return f"{' · '.join(parts)}  ({when})"


def cmd_status():
    state = load_state()
    now = time.time()
    accts = accounts()
    nxt = pick(state)
    preferred = state.get("preferred")
    emails = {a["id"]: account_email(a) for a in accts}
    width = max(len(a["id"]) for a in accts)

    for acct in accts:
        aid = acct["id"]
        until = limited_until(state, aid)
        if until > now:
            ltype = limit_type(state, aid)
            kind = f" · {LIMIT_NAMES.get(ltype, ltype)}" if ltype else ""
            label = f"LIMITED{kind} until {fmt_until(until, now)} ({fmt_left(until - now)})"
        else:
            label = "available"
        tags = [name for name, on in (("default", acct.get("isDefault")),
                                      ("preferred", aid == preferred)) if on]
        print(f"  {'▶' if aid == nxt else ' '} {aid:<{width}}  {label:<44} "
              f"{emails[aid] or 'not logged in':<30} {tilde(expand(acct['dir']))}"
              f"{'  (' + ', '.join(tags) + ')' if tags else ''}")
        used = fmt_usage(state.get("accounts", {}).get(aid, {}), now)
        if used:
            print(f"    {'':<{width}}  usage: {used}")

    # Group logins that draw on one limit: the same account and organization, not merely
    # the same email address.
    groups = []
    for acct in accts:
        for group in groups:
            if same_limit_pool(group[0], acct):
                group.append(acct)
                break
        else:
            groups.append([acct])
    for group in groups:
        if len(group) > 1:
            names = " and ".join(a["id"] for a in group)
            print(f"\n  ! {names} are logged in as the same account ({emails[group[0]['id']]}).")
            print("    They share one usage limit, so switching between them gains nothing.")

    if nxt:
        print(f"\n  next launch -> {nxt}")
    else:
        aid, until = soonest(state)
        when = fmt_until(until, now) if until else "?"
        if aid:
            print(f"\n  all accounts limited — {aid} frees up first at {when}")
        else:
            print("\n  no unpinned account is free")

    pins = load_pins()
    if pins:
        print("\n  Pinned folders")
        pw = max(len(tilde(p["path"])) for p in pins)
        for pin in pins:
            rule = {"switch": f"then {pin.get('fallback')}",
                    "ask": f"then ask about {pin.get('fallback')}",
                    "stop": "then stop"}.get(pin.get("onLimit"), "?")
            where = "terminal + VS Code" if pin.get("vscode") else "terminal"
            print(f"    {tilde(pin['path']):<{pw}}  {pin.get('account')}, {rule}  ({where})")
        here = pin_for(os.getcwd())
        if here:
            try:
                verb, aid = start_for(os.getcwd())
            except ConfigError as exc:
                verb, aid = "error", str(exc)
            shown = {"use": aid, "switch": f"{aid} (fallback)", "ask": f"asks about {aid}",
                     "stop": f"none — {aid} is limited"}.get(verb, aid)
            print(f"\n  this folder is pinned · next launch here -> {shown}")


def choose(path, answer):
    """Record the answer to an `ask` pin for VS Code windows: use its fallback, or stay
    on the limited account. It lasts until the current limit has passed. Returns the
    account new chats now start on."""
    pin = pin_for(path)
    if not pin:
        raise ConfigError(f"{tilde(canon(path))} is not pinned")
    check_pin(pin)
    pa, fb = pin["account"], pin.get("fallback")
    if answer not in ("clear", "stay", pa) and (pin["onLimit"] == "stop" or answer != fb):
        raise ConfigError(f"the pin on {tilde(pin['path'])} can only use '{pa}'"
                          + (f" or '{fb}'" if fb and pin["onLimit"] != "stop" else ""))
    with state_lock():
        state = load_state()
        chosen = state.setdefault("fallbackChosen", {})
        until = limited_until(state, pa)
        if answer == "clear" or until <= time.time():
            chosen.pop(pin["path"], None)
        else:
            chosen[pin["path"]] = {"account": pa if answer == "stay" else answer,
                                   "until": until}
        save_state(state)
    res = bind([pin["path"]])
    return res["account"]


def cmd_bind(args):
    fmt = "json"
    folders = []
    for a in args:
        if a in ("--json", "--shell"):
            fmt = a[2:]
        else:
            folders.append(a)
    # A hung filesystem must not hang a VS Code spawn: give up instead.
    try:
        import signal
        signal.signal(signal.SIGALRM, lambda *_: (_ for _ in ()).throw(TimeoutError()))
        signal.alarm(int(os.environ.get("CC_BIND_TIMEOUT", "5") or 5))
    except (ImportError, ValueError, AttributeError):
        pass
    try:
        res = bind(folders)
        code = 0
    except NotSetUp as exc:
        res, code = {"configured": False, "error": str(exc)}, 4
    except ConfigError as exc:
        res, code = {"configured": True, "error": str(exc)}, 3
    except TimeoutError:
        res, code = {"configured": True, "error": "timed out reading cc's state"}, 5
    if fmt == "json":
        print(json.dumps(res))
    else:
        # key=value lines for the wrapper's `read` loop. Not for eval.
        keys = ("error", "account", "dir", "unset", "verb", "pinned", "pin", "fallback",
                "limitedUntil", "mixed", "reason", "recheckAt", "configured")
        for k in keys:
            if k not in res:
                continue
            v = res[k]
            v = ("1" if v else "0") if isinstance(v, bool) else ("" if v is None else str(v))
            print(f"{k}={v.replace(chr(10), ' ')}")
    if code:
        print(f"cc-detect: {res['error']}", file=sys.stderr)
    return code


def _print_limit(ev):
    print(f"{ev['resetsAt']} {ev['type'] or ''}".strip())


def main(argv):
    if len(argv) < 2:
        print(__doc__.strip())
        return 2
    cmd, args = argv[1], argv[2:]

    if cmd == "slug":
        print(slugify(args[0] if args else os.getcwd()))

    elif cmd == "accounts":
        for acct in accounts():
            print(f"{acct['id']}\t{expand(acct['dir'])}\t{int(bool(acct.get('isDefault')))}")

    elif cmd == "dir":
        print(expand(account_by_id(args[0])["dir"]))

    elif cmd == "is-default":
        return 0 if account_by_id(args[0]).get("isDefault") else 1

    elif cmd == "account-of":
        acct = account_of(args[0] if args and args[0] else os.environ.get("CLAUDE_CONFIG_DIR"))
        if not acct:
            return 1
        print(f"{acct['id']}\t{int(bool(acct.get('isDefault')))}")

    elif cmd == "emails":
        for acct in accounts():
            print(f"{acct['id']}\t{account_email(acct) or ''}")

    elif cmd == "duplicate-of":
        me = account_by_id(args[0])
        for acct in accounts():
            if acct["id"] != me["id"] and same_limit_pool(me, acct):
                print(acct["id"])
                return 0
        return 1

    elif cmd == "pick":
        _refresh_quietly()
        chosen = pick()
        if not chosen:
            return 1
        print(chosen)

    elif cmd == "next-free":
        # First available account, in config order, excluding ids already used in
        # this run. Comma-separated exclusions. Exit 1 when nothing is left, which
        # is how `cc` knows tier 1 is exhausted.
        _refresh_quietly()
        exclude = set(filter(None, (args[0] if args else "").split(",")))
        chosen = next_free(exclude=exclude)
        if not chosen:
            return 1
        print(chosen)

    elif cmd == "soonest":
        _refresh_quietly()
        exclude = set(filter(None, (args[0] if args else "").split(",")))
        aid, until = soonest(exclude=exclude)
        if not aid:
            return 1
        print(f"{aid} {until}")

    elif cmd == "status":
        _refresh_quietly()
        if live_enabled():
            live_check()                        # every account, for the usage figures
        cmd_status()

    elif cmd == "use":
        aid = args[0] if args else ""
        account_by_id(aid)                      # fail loudly on an unknown id
        with state_lock():
            state = load_state()
            state["preferred"] = aid
            save_state(state)

    elif cmd == "refresh":
        refresh()

    elif cmd == "live":
        # Forced, and shown: the user asked for it. Exit 1 if no account could be read.
        ids = set(args) or None
        for aid in ids or ():
            account_by_id(aid)
        results = live_check(ids, force=True)
        now = time.time()
        for acct in accounts():
            res = results.get(acct["id"])
            if res is None:
                continue
            if isinstance(res, LiveError):
                print(f"  {acct['id']}: could not check — {res}")
                continue
            resets, ltype = live_limit(res, None, now)
            verdict = (f"LIMITED ({LIMIT_NAMES.get(ltype, ltype)}) until {fmt_until(resets, now)}"
                       if resets else "has quota left")
            print(f"  {acct['id']}: {verdict} — "
                  f"{fmt_usage({'usage': res, 'liveCheckedAt': now}, now).split('  (')[0]}")
        if not any(isinstance(r, dict) for r in results.values()):
            return 1

    elif cmd == "size":
        print(size_of(args[0], args[1], args[2] if len(args) > 2 else None))

    elif cmd == "scan":
        cwd = args[2] if len(args) > 2 else None
        offset = int(args[3]) if len(args) > 3 else 0
        ev = scan(args[0], args[1], cwd, offset)
        if not ev:
            return 1
        _print_limit(ev)

    elif cmd == "session-limit":
        # For hooks running inside a session. `own` counts only a limit written
        # since this session's recorded run started on <id>, and needs that record.
        # `recent` also accepts the last 15 minutes when no run was recorded —
        # used by the StopFailure hook, which fires the moment the limit lands.
        path, aid, session = args[0], args[1], args[2]
        mode = args[3] if len(args) > 3 else "own"
        run = latest_run(load_state().get("runs", []), session, aid=aid)
        started = run.get("startedAt") if run else None
        if mode == "own":
            if started is None:
                return 1
            since = started
        else:
            since = max(time.time() - 900, started or 0)
        ev = session_limit(path, since)
        if not ev:
            return 1
        _print_limit(ev)

    elif cmd in ("mark", "raise"):
        aid, resets = args[0], int(args[1])
        ltype = args[2] if len(args) > 2 else None
        account_by_id(aid)                      # fail loudly on an unknown id
        with state_lock():
            state = load_state()
            if cmd == "raise":
                raise_limit(state, aid, resets, ltype)
            else:
                entry = state.setdefault("accounts", {}).setdefault(aid, {})
                entry["limitedUntil"] = resets
                if ltype and resets:
                    entry["limitType"] = ltype
                else:
                    entry.pop("limitType", None)
            save_state(state)

    elif cmd == "record-run":
        account_by_id(args[0])
        record_run(args[0], args[1])

    elif cmd == "get":
        value = config_get(args[0], args[1] if len(args) > 1 else None)
        if value is None or value is False:
            return 1
        print("" if value is True else value)

    elif cmd == "until":
        account_by_id(args[0])
        print(limited_until(load_state(), args[0]))

    elif cmd == "canon":
        print(canon(args[0] if args else None))

    elif cmd == "pin":
        if len(args) < 3:
            print("usage: cc-detect pin <path> <id> <switch|stop|ask> [fallback] [vscode]",
                  file=sys.stderr)
            return 2
        fb = args[3] if len(args) > 3 and args[3] not in ("", "-") else None
        vscode = (args[4] if len(args) > 4 else "1") != "0"
        print(set_pin(args[0], args[1], args[2], fb, vscode))

    elif cmd == "unpin":
        root = remove_pin(args[0] if args else None)
        if not root:
            return 1
        print(root)

    elif cmd == "pins":
        for pin in load_pins():
            print("\t".join([pin["path"], pin.get("account") or "", pin.get("onLimit") or "",
                             pin.get("fallback") or "-", "1" if pin.get("vscode") else "0"]))

    elif cmd == "pin-of":
        pin = pin_for(args[0] if args else None)
        if not pin:
            return 1
        print("\t".join([pin["path"], pin.get("account") or "", pin.get("onLimit") or "",
                         pin.get("fallback") or "-", "1" if pin.get("vscode") else "0"]))

    elif cmd == "start-for":
        _refresh_quietly()
        verb, aid = start_for(args[0] if args and args[0] else None,
                              args[1] if len(args) > 1 and args[1] else None)
        print(f"{verb} {aid}".strip())

    elif cmd == "bind":
        return cmd_bind(args)

    elif cmd == "choose":
        # choose <dir> <account|stay|clear>: the answer to an `ask` pin, for VS Code.
        if len(args) < 2:
            print("usage: cc-detect choose <dir> <account|stay|clear>", file=sys.stderr)
            return 2
        print(choose(args[0], args[1]))

    elif cmd == "fallback-for":
        _refresh_quietly()
        used = filter(None, (args[2] if len(args) > 2 else "").split(","))
        verb, aid = fallback_for(args[0], args[1], used)
        print(f"{verb} {aid}".strip())

    elif cmd == "statusline":
        run_statusline(args[0], args[1], sys.stdin.read())

    elif cmd == "turn-ended":
        try:
            turn_ended(json.load(sys.stdin))
        except ValueError:
            pass

    elif cmd == "early-settings":
        print(early_settings(args[0], args[1], args[2], os.path.realpath(__file__)))

    elif cmd == "early-check":
        aid, session, transcript = args[0], args[1], args[2]
        pct = float(args[3]) if len(args) > 3 else early_percent()
        over = usage_over(aid, pct)
        if not over or not between_turns(session, transcript):
            return 1
        print(f"{over[0]} {over[1]}")

    elif cmd == "fallback":
        cfg = load_config().get("fallbacks", {}).get(args[0], {})
        value = cfg.get(args[1])
        if value is None or value is False:
            return 1
        print("" if value is True else value)

    else:
        print(f"unknown subcommand: {cmd}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except ConfigError as exc:
        print(f"cc-detect: {exc}", file=sys.stderr)
        sys.exit(3)
