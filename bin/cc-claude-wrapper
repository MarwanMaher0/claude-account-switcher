#!/usr/bin/env bash
# cc-claude-wrapper — the account switch for Claude in VS Code.
#
# Set once, in VS Code's USER settings, as claudeCode.claudeProcessWrapper (cc vscode on
# does it). The Claude extension then starts every Claude process as
#
#     cc-claude-wrapper <bundled claude binary> <args...>
#
# with the session's folder as the working directory. This script asks
# `cc-detect bind` which account that folder runs on and execs the binary on it:
#   - the default account: CLAUDE_CONFIG_DIR removed, never set to ~/.claude
#   - any other account:   CLAUDE_CONFIG_DIR=<that account's dir>, exactly as cc writes it
# An inherited CLAUDE_CONFIG_DIR is always overridden.
#
# The folder is $CC_WINDOW_FOLDER when set (the cc-switch companion extension exports
# the window's folder, so helper processes started in a temp dir still resolve by
# window), else the working directory.
#
# Fails closed: when the account cannot be decided for a folder that is, or may be,
# pinned, nothing runs; for any other folder Claude runs on the default account. When
# cc was never set up, Claude runs unchanged.
#
# It is on the path of every Claude spawn, including `auth status --json`, so it
# must stay fast and must never read stdin (that is Claude's stream-json channel).
# Only a resume in a pinned folder does more: a bounded `cc-vscode adopt --quick`.
# Plain bash 3.2.

# The extension passes its bundled binary first. A build or platform without one
# passes only Claude's own arguments and leaves finding Claude to the wrapper; Claude
# never takes a program path as its first argument, so anything that is not an
# executable file (a flag, say) means "no binary given": use the `claude` on PATH.
real="${1:-}"
if [ -n "$real" ] && [ "${real#-}" = "$real" ] && [ -f "$real" ] && [ -x "$real" ]; then
    shift
else
    # The first `claude` on PATH, skipping cc's own terminal shim (which calls back here).
    real=""
    oldifs="$IFS"; IFS=:
    for d in $PATH; do
        case "$d" in ""|"$HOME/.claude-switch/terminal-bin") continue ;; esac
        if [ -f "$d/claude" ] && [ -x "$d/claude" ]; then real="$d/claude"; break; fi
    done
    IFS="$oldifs"
    if [ -z "$real" ]; then
        echo "cc-switch: no Claude binary was passed to cc-claude-wrapper and none is on PATH" >&2
        exit 1
    fi
fi

SWITCH_DIR="$HOME/.claude-switch"
folder="${CC_WINDOW_FOLDER:-$PWD}"
[ -n "$folder" ] || folder="$PWD"

# The resolved form of a directory, or the path itself when it cannot be entered.
resolved() { (cd "$1" 2>/dev/null && pwd -P) || printf '%s' "$1"; }

DEFAULT_REAL="$(resolved "$HOME/.claude")"

# Run Claude with CLAUDE_CONFIG_DIR removed (the default account).
run_default() { exec env -u CLAUDE_CONFIG_DIR "$real" "$@"; }

# Run Claude unchanged (cc is not set up), except that an inherited CLAUDE_CONFIG_DIR
# naming the default account's own dir is removed: that value makes Claude Code
# replace its login.
run_unchanged() {
    if [ -n "${CLAUDE_CONFIG_DIR:-}" ] && [ "$(resolved "$CLAUDE_CONFIG_DIR")" = "$DEFAULT_REAL" ]; then
        run_default "$@"
    fi
    exec "$real" "$@"
}

# cc was never set up here: nothing to decide.
if [ ! -e "$SWITCH_DIR/config.json" ] && [ ! -e "$SWITCH_DIR/pins.json" ]; then
    run_unchanged "$@"
fi

# cc-detect: an explicit override, then the copy installed beside this script, then
# ~/.local/bin.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
detect="${CC_SWITCH_DETECT:-}"
[ -n "$detect" ] || detect="$here/cc-detect"
[ -x "$detect" ] || detect="$HOME/.local/bin/cc-detect"

# Whether the folder is, or might be, under a pin, judged without cc-detect: used only
# when cc-detect could not answer. Any pin path that cannot be read plainly (JSON
# escapes) counts as a match, so a doubt always fails closed.
may_be_pinned() {
    local pins="$SWITCH_DIR/pins.json" real_folder line path parsed=0 keys
    [ -e "$pins" ] || return 1
    { [ -f "$pins" ] && [ -r "$pins" ]; } || return 0
    real_folder="$(resolved "$folder")"
    while IFS= read -r line; do
        path="${line#*\"path\"*:*\"}"
        path="${path%%\"*}"
        case "$line" in *\\*) return 0 ;; esac
        parsed=$((parsed + 1))
        [ -n "$path" ] || continue
        case "$real_folder/" in "$path"/*) return 0 ;; esac
        case "$folder/" in "$path"/*) return 0 ;; esac
    done < <(grep -o '"path"[[:space:]]*:[[:space:]]*"[^"]*\(\\.[^"]*\)*"' "$pins" 2>/dev/null)
    # A "path" key whose value could not be read (a truncated file, say) is a doubt.
    keys="$(grep -o '"path"' "$pins" 2>/dev/null | wc -l | tr -d ' ')"
    [ "${keys:-0}" -gt "$parsed" ] && return 0
    # No path at all: only an empty pin list is a clear "not pinned".
    if [ "$parsed" -eq 0 ]; then
        tr -d ' \t\r\n' < "$pins" 2>/dev/null | grep -qE '^(\{("version":[0-9]+,?)?("pins":\[\])?,?("version":[0-9]+)?\})?$' && return 1
        return 0
    fi
    return 1
}

fail() {
    local reason="$1"
    shift
    if may_be_pinned; then
        printf 'cc-switch: could not decide the account for %s: %s; run cc status\n' "$folder" "$reason" >&2
        exit 1
    fi
    # Not pinned: run on the default account. An inherited CLAUDE_CONFIG_DIR may name an
    # account reserved for another folder's pin (the window's last binding, or whatever
    # VS Code was started with); the default account is never reserved.
    printf 'cc-switch: could not decide the account for %s: %s; running Claude on the default account\n' "$folder" "$reason" >&2
    run_default "$@"
}

if [ ! -x "$detect" ]; then
    fail "cc-detect was not found" "$@"
fi

out="$(CC_LIVE_CHECK=0 CC_BIND_TIMEOUT="${CC_BIND_TIMEOUT:-5}" "$detect" bind "$folder" --shell </dev/null 2>/dev/null)"
rc=$?

account="" dir="" unset_="" error="" configured="" pin="" pin_account=""
while IFS= read -r line; do
    case "$line" in
        account=*)    account="${line#account=}" ;;
        pin=*)        pin="${line#pin=}" ;;
        pinAccount=*) pin_account="${line#pinAccount=}" ;;
        dir=*)        dir="${line#dir=}" ;;
        unset=*)      unset_="${line#unset=}" ;;
        error=*)      error="${line#error=}" ;;
        configured=*) configured="${line#configured=}" ;;
    esac
done <<EOF
$out
EOF

if [ "$rc" -eq 4 ] && [ "$configured" = "0" ]; then
    run_unchanged "$@"                    # cc is not set up after all
fi
if [ "$rc" -ne 0 ] || [ -z "$account" ]; then
    fail "${error:-cc-detect bind exited with status $rc}" "$@"
fi

# Resuming in a pinned folder: link the folder's chats that other accounts hold into
# the pin's account first, so the session being resumed is there (it may predate the
# pin). Only for a resume, never for the many other spawns; bounded by adopt itself
# (--quick: about two seconds, then it stops), output dropped, its status ignored. It
# only adds links, so stopping early or failing never stands in the way of the launch.
# The session being resumed goes first, so a large backlog never crowds it out. While
# the pin is limited and Claude runs on its fallback, that session is linked on into
# the fallback account too (--also-to), where this resume reads it.
if [ -n "$pin" ]; then
    resume="" sid="" prev=""
    for a in "$@"; do
        case "$prev" in
            --resume|-r) case "$a" in -*) ;; *) sid="$a" ;; esac ;;
        esac
        case "$a" in
            --resume|-r|--continue|-c) resume=1 ;;
            --resume=*) resume=1; sid="${a#--resume=}" ;;
        esac
        prev="$a"
    done
    if [ -n "$resume" ]; then
        vscode_tool="$(dirname "$detect")/cc-vscode"
        if [ ! -x "$vscode_tool" ]; then
            :
        elif [ -z "$sid" ]; then
            CC_LIVE_CHECK=0 "$vscode_tool" adopt --folder "$pin" --quick --quiet </dev/null >/dev/null 2>&1
        elif [ -n "$pin_account" ] && [ "$account" != "$pin_account" ]; then
            CC_LIVE_CHECK=0 "$vscode_tool" adopt --folder "$pin" --quick --quiet --session "$sid" \
                --also-to "$account" </dev/null >/dev/null 2>&1
        else
            CC_LIVE_CHECK=0 "$vscode_tool" adopt --folder "$pin" --quick --quiet --session "$sid" \
                </dev/null >/dev/null 2>&1
        fi
    fi
fi

if [ "$unset_" = "1" ]; then
    run_default "$@"
fi
if [ -z "$dir" ]; then
    fail "no directory for account '$account'" "$@"
fi
# Never point CLAUDE_CONFIG_DIR at the default account's own dir, whatever bind said.
if [ "$(resolved "$dir")" = "$DEFAULT_REAL" ]; then
    run_default "$@"
fi
exec env CLAUDE_CONFIG_DIR="$dir" "$real" "$@"
