#!/usr/bin/env bash
# cc — run several Claude Code accounts and fail over when one hits its rate limit.
#
# Starts on the first account that is not rate limited. When that account hits its
# limit the conversation is handed to the next one: the transcript is copied into
# that account's config dir and reopened with --resume, so the conversation
# continues rather than starting over.
#
# An account is bound at process start (CLAUDE_CONFIG_DIR is read once), so a live
# session can never change accounts — every handoff is between runs.
#
#   cc                     start on a healthy account (the preferred one while it is free)
#   cc use <id>            prefer an account for new sessions — terminal and VS Code panel
#   cc status              which accounts are limited, by which window, until when
#   cc refresh             ask Anthropic for each account's real usage and fix stale limits
#   cc add <id>            create, sign in and register another account
#   cc add <id> --email X  pre-fill the login with X and refuse any other account
#   cc remove <id>         deregister an account  (--purge also deletes its dir)
#   cc clear <id>          forget a limit recorded for an account
#   cc vscode on|off       run each VS Code window on its folder's account (wrapper + companion)
#   cc vscode migrate      clean up what older versions wrote (a dry run unless --apply)
#   cc pin [folder]        keep a folder (and its subfolders) on one account — asks which
#   cc pin <folder> --account <id> --fallback <id>|none|ask [--no-vscode]
#   cc unpin [folder]      remove a pin
#   cc pins                list pinned folders
#   cc adopt [folder]      bring a pinned folder's chats from other accounts into its own
#   cc adopt [folder] --dry-run | --from <id> | --all
#   cc cloud "<task>"      start a cloud session on the account holding the cloud credit
#   cc cloud set <id>      choose that account  (cc cloud --acct <id> overrides once)
#   cc --acct <id>         force a specific account for this run
#   cc --manual            never end a run automatically on a limit
#   cc --no-auto-continue  after a switch, wait for you instead of carrying on by itself
#   cc -- <claude args>    hand anything else straight to claude
#
# Inside a pinned folder the pin decides: its account, then only the fallback it names
# (or nothing). Elsewhere, cc rotates over the accounts that are not pinned anywhere.
#
# Config: ~/.claude-switch/config.json    State: ~/.claude-switch/state.json
# Pins:   ~/.claude-switch/pins.json

set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DETECT="$HERE/cc-detect"
WATCH="$HERE/cc-watch"
VSCODE="$HERE/cc-vscode"
AUTOKILL=1
AUTO_CONTINUE=1
RUN_DIR="$HOME/.claude-switch/run"
# cc chooses the account of every Claude it starts. In a VS Code terminal whose PATH
# leads `claude` through cc-claude-wrapper (claudeCode.useTerminal), this tells cc's
# terminal shim to run Claude directly.
export CC_SWITCH_DIRECT=1

c_dim=$'\033[2m'; c_yel=$'\033[33m'; c_grn=$'\033[32m'; c_bold=$'\033[1m'; c_rst=$'\033[0m'
note() { printf '%s[cc]%s %s\n' "$c_dim" "$c_rst" "$*" >&2; }
warn() { printf '%s[cc]%s %s\n' "$c_yel" "$c_rst" "$*" >&2; }
good() { printf '%s[cc]%s %s\n' "$c_grn" "$c_rst" "$*" >&2; }
die()  { printf '%s[cc]%s %s\n' "$c_yel" "$c_rst" "$*" >&2; exit 1; }

[ -x "$DETECT" ] || die "missing $DETECT"

# ---- helpers ----------------------------------------------------------------
acct_dir()   { "$DETECT" dir "$1"; }
is_default() { "$DETECT" is-default "$1"; }

# The default account keeps its config at ~/.claude.json, BESIDE the directory.
# Any <dir>/.claude.json there is debris from launching it with CLAUDE_CONFIG_DIR
# set — the mistake this launcher exists to avoid.
acct_email() {
    python3 - "$1" "$2" <<'PY' 2>/dev/null || echo "not logged in"
import json, os, sys
d, is_default = os.path.expanduser(sys.argv[1]), sys.argv[2] == "1"
path = os.path.expanduser("~/.claude.json") if is_default else os.path.join(d, ".claude.json")
try:
    acct = json.load(open(path)).get("oauthAccount", {})
    print(acct.get("emailAddress") or "not logged in")
except Exception:
    print("not logged in")
PY
}

acct_label() {
    local id="$1" dir def
    dir="$(acct_dir "$id")" || return 1
    if is_default "$id"; then def=1; else def=0; fi
    printf '%s · %s' "$id" "$(acct_email "$dir" "$def")"
}

# Launch claude for one account. THE critical branch: the default account must run
# with CLAUDE_CONFIG_DIR REMOVED, not set to its own path. Setting it makes Claude
# Code look for ~/.claude/.claude.json, find nothing, run onboarding, and overwrite
# ~/.claude/.credentials.json with whatever account logs in next.
run_acct() {
    local id="$1"; shift
    local dir; dir="$(acct_dir "$id")"
    if is_default "$id"; then
        env -u CLAUDE_CONFIG_DIR claude "$@"
    else
        env CLAUDE_CONFIG_DIR="$dir" claude "$@"
    fi
}

new_session() { python3 -c 'import uuid; print(uuid.uuid4())'; }

# GNU `date -d @epoch` and BSD/macOS `date -r epoch` do the same job with
# different flags. Try both rather than assuming GNU coreutils. A reset more than
# 20 hours away gets its weekday — "07:00" for a weekly limit reads as today.
fmt_time() {
    local fmt='+%H:%M'
    [ $(( $1 - $(date +%s) )) -gt 72000 ] 2>/dev/null && fmt='+%a %H:%M'
    date -d "@$1" "$fmt" 2>/dev/null || date -r "$1" "$fmt" 2>/dev/null || echo '?'
}

# Nudge open VS Code windows to re-check their account. Silent; writes no settings.
sync_vscode() {
    [ -x "$VSCODE" ] && "$VSCODE" sync --quiet >/dev/null 2>&1
    return 0
}

# Pins are stored with symlinks resolved, so match the resolved home too: on macOS /var
# is a link to /private/var.
REAL_HOME="$(cd "$HOME" 2>/dev/null && pwd -P)" || REAL_HOME="$HOME"
tilde() {
    case "$1" in
        "$HOME"|"$HOME"/*)           printf '~%s' "${1#"$HOME"}" ;;
        "$REAL_HOME"|"$REAL_HOME"/*) printf '~%s' "${1#"$REAL_HOME"}" ;;
        *) printf '%s' "$1" ;;
    esac
}

default_id() { "$DETECT" accounts | awk -F'\t' '$3 == 1 { print $1; exit }'; }

# ---- menus ------------------------------------------------------------------
# menu <question> <default index> <option>...  — the chosen index lands in MENU_PICK.
# Arrow keys (or j/k, or a digit) and Enter on a terminal. With no terminal, or
# TERM=dumb, a numbered list read line by line from stdin, so scripts and tests can
# answer it. Returns 1 when cancelled (q, or end of input). Plain bash 3.2.
MENU_PICK=0
menu() {
    local question="$1" sel="$2" i key rest
    shift 2
    local opts=("$@") n=$#
    if [ -t 0 ] && [ -t 2 ] && [ "${TERM:-dumb}" != "dumb" ] && [ -z "${CC_NUMBERED_MENUS:-}" ]; then
        printf '%s%s%s  %s(↑/↓, Enter)%s\n' "$c_bold" "$question" "$c_rst" "$c_dim" "$c_rst" >&2
        printf '\033[?25l' >&2
        trap 'printf "\033[?25h\n" >&2; exit 130' INT
        while :; do
            i=0
            while [ "$i" -lt "$n" ]; do
                if [ "$i" -eq "$sel" ]; then
                    printf '\033[2K  %s▶ %s%s\n' "$c_grn" "${opts[$i]}" "$c_rst" >&2
                else
                    printf '\033[2K    %s\n' "${opts[$i]}" >&2
                fi
                i=$((i + 1))
            done
            IFS= read -rsn1 key || key=q
            case "$key" in
                $'\033') IFS= read -rsn2 rest || rest=""
                          case "$rest" in
                              "[A"|"OA") sel=$(( (sel + n - 1) % n )) ;;
                              "[B"|"OB") sel=$(( (sel + 1) % n )) ;;
                          esac ;;
                k) sel=$(( (sel + n - 1) % n )) ;;
                j) sel=$(( (sel + 1) % n )) ;;
                [1-9]) [ "$key" -le "$n" ] && sel=$((key - 1)) ;;
                "") break ;;
                q) printf '\033[?25h' >&2; trap - INT; return 1 ;;
            esac
            printf '\033[%dA' "$n" >&2
        done
        printf '\033[?25h' >&2
        trap - INT
    else
        printf '%s\n' "$question" >&2
        i=0
        while [ "$i" -lt "$n" ]; do
            printf '  %d) %s\n' "$((i + 1))" "${opts[$i]}" >&2
            i=$((i + 1))
        done
        while :; do
            printf '  choose 1-%d [%d]: ' "$n" "$((sel + 1))" >&2
            IFS= read -r key || { printf '\n' >&2; return 1; }
            [ -z "$key" ] && break
            case "$key" in
                *[!0-9]*) ;;
                *) if [ "$key" -ge 1 ] && [ "$key" -le "$n" ]; then sel=$((key - 1)); break; fi ;;
            esac
            printf '  type a number from 1 to %d\n' "$n" >&2
        done
    fi
    MENU_PICK=$sel
}

# confirm <question> <y|n>  — Enter takes the default; end of input is "no".
confirm() {
    local hint="y/N" ans
    [ "$2" = "y" ] && hint="Y/n"
    printf '%s%s (%s)%s ' "$c_bold" "$1" "$hint" "$c_rst" >&2
    IFS= read -r ans || { printf '\n' >&2; return 1; }
    [ -z "$ans" ] && ans="$2"
    case "$ans" in [yY]*) return 0 ;; *) return 1 ;; esac
}

# ---- cc pin / unpin / pins --------------------------------------------------
# The interactive part of `cc pin`. Sets PIN_ACCT, PIN_FB (an id, none, or ask) and
# PIN_VSCODE; returns 1 when the user backs out.
pin_menu() {
    local folder="$1" dflt="$2" sel=0 ids labels id email name i
    printf '\nFolder: %s   (all subfolders included)\n\n' "$(tilde "$folder")" >&2
    while :; do
        ids=(); labels=()
        while IFS=$'\t' read -r id email; do
            ids+=("$id")
            labels+=("$(printf '%-10s %s' "$id" "${email:-not logged in}")")
        done < <("$DETECT" emails)
        labels+=("+ Add a new account")
        menu "Which account should this folder use?" "$sel" "${labels[@]}" || return 1
        if [ "$MENU_PICK" -lt "${#ids[@]}" ]; then
            PIN_ACCT="${ids[$MENU_PICK]}"
            break
        fi
        printf '%sName for the new account (a-z, 0-9, - and _):%s ' "$c_bold" "$c_rst" >&2
        IFS= read -r name || return 1
        [ -n "$name" ] || continue
        if "$HERE/cc" add "$name"; then
            i=0
            for id in "${ids[@]}"; do i=$((i + 1)); done
            sel=$i                           # a new account is appended last
        fi
        echo >&2
    done

    # Only an account that is not pinned anywhere can catch this folder's overflow:
    # normally that is the default account. One employer's account never covers another's.
    local fbs=() fbl=() pinned
    pinned=" $("$DETECT" pins | awk -F'\t' -v me="$folder" '$1 != me { printf "%s ", $2 }')"
    if [ "$PIN_ACCT" != "$dflt" ]; then
        fbs+=("$dflt"); fbl+=("Switch to $dflt")
    else
        for id in "${ids[@]}"; do
            [ "$id" = "$dflt" ] && continue
            case "$pinned" in *" $id "*) continue ;; esac
            fbs+=("$id"); fbl+=("Switch to $id")
        done
    fi
    fbl+=("Stop and wait for reset")
    [ "${#fbs[@]}" -gt 0 ] && fbl+=("Ask me each time")
    echo >&2
    menu "If $PIN_ACCT hits its limit:" 0 "${fbl[@]}" || return 1
    if [ "$MENU_PICK" -lt "${#fbs[@]}" ]; then
        PIN_FB="${fbs[$MENU_PICK]}"
    elif [ "$MENU_PICK" -eq "${#fbs[@]}" ]; then
        PIN_FB=none
    else
        PIN_FB="ask:${fbs[0]}"
    fi

    echo >&2
    menu "Apply to:" 0 "Terminal and VS Code" "Terminal only" || return 1
    PIN_VSCODE=1
    [ "$MENU_PICK" -eq 1 ] && PIN_VSCODE=0
    echo >&2
    confirm "Save?" y
}

cmd_pin() {
    local path="" acct="" fb="" vscode=1
    while [ $# -gt 0 ]; do
        case "$1" in
            --account|--fallback)
                { [ $# -ge 2 ] && [ -n "$2" ]; } || die "cc pin: $1 needs a value"
                if [ "$1" = "--account" ]; then acct="$2"; else fb="$2"; fi
                shift 2 ;;
            --no-vscode) vscode=0; shift ;;
            --yes|-y) shift ;;                 # accepted for older scripts; nothing to confirm
            -*) die "cc pin: unknown option $1" ;;
            *) [ -z "$path" ] || die "cc pin: one folder at a time"; path="$1"; shift ;;
        esac
    done
    [ -n "$path" ] || path="$PWD"
    [ -d "$path" ] || die "cc pin: not a folder: $path"
    "$DETECT" accounts >/dev/null || exit 3
    local folder dflt
    folder="$("$DETECT" canon "$path")"
    dflt="$(default_id)"

    if [ -z "$acct" ]; then
        PIN_ACCT=""; PIN_FB=""; PIN_VSCODE=1
        pin_menu "$folder" "$dflt" || die "nothing saved"
        acct="$PIN_ACCT"; fb="$PIN_FB"; vscode="$PIN_VSCODE"
    fi

    local on_limit fb_id
    case "${fb:-none}" in
        none|stop) on_limit=stop; fb_id="-" ;;
        ask)       on_limit=ask;  fb_id="$dflt" ;;
        ask:*)     on_limit=ask;  fb_id="${fb#ask:}" ;;
        *)         on_limit=switch; fb_id="$fb" ;;
    esac
    "$DETECT" pin "$folder" "$acct" "$on_limit" "$fb_id" "$vscode" >/dev/null || exit $?
    # The folder's chats follow the pin: link the ones other accounts hold into $acct,
    # so its history and resume keep showing them. (Open VS Code windows do the same
    # before they move; this covers the terminal and windows opened later.)
    adopt_pinned "$folder"

    local rule
    case "$on_limit" in
        switch) rule="then $fb_id" ;;
        ask)    rule="then ask about $fb_id" ;;
        stop)   rule="then stop and wait" ;;
    esac
    good "$(tilde "$folder") -> $acct, $rule"
    if [ "$vscode" = "1" ]; then
        note "VS Code windows on $(tilde "$folder") now use $acct for new chats (open windows re-check automatically)"
        "$VSCODE" enabled 2>/dev/null || note "VS Code follows pins once you run: cc vscode on"
    fi
    sync_vscode
    return 0
}

# Link a pinned folder's chats into its account; report what happened, never fail.
adopt_pinned() {
    local out line
    [ -x "$VSCODE" ] || return 0
    if out="$("$VSCODE" adopt --folder "$1" </dev/null 2>&1)"; then
        case "$out" in *": nothing to bring over") return 0 ;; esac
        while IFS= read -r line; do note "$line"; done <<EOF
$out
EOF
    else
        while IFS= read -r line; do warn "$line"; done <<EOF
$out
EOF
        warn "not every chat of $(tilde "$1") could be brought over; run: cc adopt $(tilde "$1")"
    fi
    return 0
}

cmd_adopt() {
    [ -x "$VSCODE" ] || die "missing $VSCODE"
    "$DETECT" accounts >/dev/null || exit 3
    local args=() folder=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --from)
                { [ $# -ge 2 ] && [ -n "$2" ]; } || die "cc adopt: --from needs an account"
                args+=("$1" "$2"); shift 2 ;;
            --dry-run|-n|--all|--json) args+=("$1"); shift ;;
            -*) die "cc adopt: unknown option $1" ;;
            *) [ -z "$folder" ] || die "cc adopt: one folder at a time"; folder="$1"; shift ;;
        esac
    done
    case " ${args[*]:-} " in
        *" --all "*) [ -z "$folder" ] || die "cc adopt: a folder or --all, not both" ;;
        *) args+=(--folder "${folder:-$PWD}") ;;
    esac
    "$VSCODE" adopt "${args[@]}"
}

cmd_unpin() {
    local path="${1:-$PWD}" folder pin
    "$DETECT" accounts >/dev/null || exit 3
    folder="$("$DETECT" canon "$path")"
    if ! "$DETECT" pins | cut -f1 | grep -qxF "$folder"; then
        if pin="$("$DETECT" pin-of "$folder")"; then
            die "$(tilde "$folder") is inside the pin on $(tilde "${pin%%$'\t'*}") — run: cc unpin $(tilde "${pin%%$'\t'*}")"
        fi
        die "$(tilde "$folder") is not pinned"
    fi
    "$DETECT" unpin "$folder" >/dev/null
    sync_vscode
    good "unpinned $(tilde "$folder")"
}

cmd_pins() {
    local rows
    "$DETECT" accounts >/dev/null || exit 3
    rows="$("$DETECT" pins)"
    if [ -z "$rows" ]; then
        note "no pinned folders — run cc pin inside one"
        return 0
    fi
    printf '%s\n' "$rows" | while IFS=$'\t' read -r path acct on fb vs; do
        case "$on" in
            switch) rule="then $fb" ;;
            ask)    rule="then ask about $fb" ;;
            *)      rule="then stop" ;;
        esac
        where="terminal"
        [ "$vs" = "1" ] && where="terminal + VS Code"
        printf '  %-40s %-10s %-24s %s\n' "$(tilde "$path")" "$acct" "$rule" "$where"
    done
}

# ---- cc status --------------------------------------------------------------
cmd_status() {
    echo
    "$DETECT" status || return $?
    [ -x "$VSCODE" ] && "$VSCODE" status
    echo
}

# ---- cc refresh -------------------------------------------------------------
# A recorded limit is only what a transcript once said. This asks the server, so an
# account whose window has rolled over is back in rotation at once.
cmd_refresh() {
    echo
    "$DETECT" live "$@" || warn "no account's usage could be read — recorded limits left as they were"
    sync_vscode
    cmd_status
}

# ---- cc add -----------------------------------------------------------------
cmd_add() {
    local id="" dir="" adopt=0 want_email=""
    id="${1:-}"; shift || true
    [ -n "$id" ] || die "usage: cc add <id> [--email <address>]    e.g.  cc add work"
    while [ $# -gt 0 ]; do
        case "$1" in
            --dir|--email)
                # `shift 2` with one argument left shifts nothing, which would loop forever.
                { [ $# -ge 2 ] && [ -n "$2" ]; } || die "cc add: $1 needs a value"
                if [ "$1" = "--dir" ]; then dir="$2"; else want_email="$2"; fi
                shift 2 ;;
            --adopt) adopt=1; shift ;;
            *) die "cc add: unknown option $1" ;;
        esac
    done
    [[ "$id" =~ ^[a-z0-9][a-z0-9_-]{0,31}$ ]] || die "invalid id: $id (a-z, 0-9, - and _)"
    [ -n "$dir" ] || dir="$HOME/.claude-$id"

    # Create config.json on a first run, as every other command does, and stop on a broken
    # one. Without this, `cc add` as the first command ever run crashed reading a file that
    # did not exist yet.
    "$DETECT" accounts >/dev/null || exit 3

    python3 - "$id" "$dir" "$adopt" <<'PY' || exit 1
import json, os, re, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
HOME = os.path.expanduser("~")
CONFIG = os.path.join(HOME, ".claude-switch", "config.json")
aid, adir, adopt = sys.argv[1], os.path.abspath(os.path.expanduser(sys.argv[2])), sys.argv[3] == "1"

# Checked FIRST, and before any "already registered" message: this is the
# dangerous case, and it must be named as such even when ~/.claude happens not to
# be registered yet. A second account pointed at ~/.claude would be launched with
# CLAUDE_CONFIG_DIR set, which makes Claude Code run onboarding and overwrite the
# default account's credentials on first login.
if adir == os.path.abspath(os.path.join(HOME, ".claude")):
    sys.exit("cc add: refusing — ~/.claude is the default account's own directory. "
             "Registering it again would overwrite its credentials on login.")

cfg = json.load(open(CONFIG))
for acct in cfg["accounts"]:
    if acct["id"] == aid:
        sys.exit(f"cc add: account {aid} already exists")
    if os.path.abspath(os.path.expanduser(acct["dir"])) == adir:
        sys.exit(f"cc add: {adir} is already registered as {acct['id']}")
if not adopt and os.path.isdir(adir) and os.listdir(adir):
    sys.exit(f"cc add: {adir} exists and is not empty (use --adopt to register it as-is)")
PY

    # An adopted directory that is already signed in needs no login.
    local need_login=1
    if [ "$adopt" = "1" ] && [ "$(acct_email "$dir" 0)" != "not logged in" ]; then
        need_login=0
    fi

    # Ask which address the user means, before anything is created, so the check against
    # the browser's open session is on without anyone having to know about --email.
    # Enter skips it. Asked only when someone is at the keyboard.
    if [ "$need_login" = "1" ] && [ -z "$want_email" ] && { [ -t 0 ] || [ -n "${CC_PROMPT:-}" ]; }; then
        printf '%s[cc]%s email of the account to add (Enter to skip): ' "$c_bold" "$c_rst" >&2
        read -r want_email || want_email=""
    fi
    case "$want_email" in
        ""|*@*) ;;
        *) die "cc add: '$want_email' is not an email address" ;;
    esac

    local created=0
    if [ "$adopt" = "0" ]; then
        mkdir -p "$dir" && chmod 700 "$dir" && created=1
        # settings only — never credentials, history, projects or sessions
        local src="$HOME/.claude"
        for f in settings.json CLAUDE.md; do
            [ -f "$src/$f" ] && cp -p "$src/$f" "$dir/$f"
        done
        # The cc-switch plugin's hooks record limits inside sessions. Share the
        # default account's copy rather than installing it again per account.
        if [ -d "$src/skills/cc-switch" ]; then
            mkdir -p "$dir/skills" && ln -s "$src/skills/cc-switch" "$dir/skills/cc-switch"
        fi
    fi

    # Register before login so the dir is discoverable, then roll back if login fails.
    python3 - "$id" "$dir" <<'PY'
import json, os, sys
HOME = os.path.expanduser("~")
CONFIG = os.path.join(HOME, ".claude-switch", "config.json")
STATE = os.path.join(HOME, ".claude-switch", "state.json")
aid, adir = sys.argv[1], sys.argv[2]
cfg = json.load(open(CONFIG))
cfg["accounts"].append({"id": aid, "dir": adir})
tmp = CONFIG + ".tmp"
json.dump(cfg, open(tmp, "w"), indent=2); os.chmod(tmp, 0o600); os.replace(tmp, CONFIG)
# a re-added id must not inherit a stale limit window
try:
    st = json.load(open(STATE))
    if st.get("accounts", {}).pop(aid, None) is not None:
        t = STATE + ".tmp"
        json.dump(st, open(t, "w"), indent=2); os.chmod(t, 0o600); os.replace(t, STATE)
except Exception:
    pass
PY

    note "adding '$id' ($(tilde "$dir"))"
    if [ "$need_login" = "1" ]; then
        login_account "$id" "$dir" "$want_email"
    else
        note "already signed in — no login needed"
    fi

    local email
    email="$(acct_email "$dir" 0)"
    if [ "$email" = "not logged in" ]; then
        rollback_add "$id" "$created" "$dir"
        die "no login completed for '$id' — nothing added. Run cc add $id again when you are ready to sign in."
    fi

    # --email names the account the user meant. The browser can still sign in as
    # whoever it already has open, so check what actually arrived.
    if [ -n "$want_email" ] && \
       [ "$(printf '%s' "$email" | tr '[:upper:]' '[:lower:]')" != "$(printf '%s' "$want_email" | tr '[:upper:]' '[:lower:]')" ]; then
        warn "'$id' signed in as $email, not $want_email."
        rollback_add "$id" "$created" "$dir"
        die "nothing added. Use a private browser window, then run: cc add $id --email $want_email"
    fi

    # Two logins of one account in one organization share one usage limit, so a second
    # adds nothing but a wasted hop on every failover. The match is on account and
    # organization ids, not email: a personal plan and a work seat can share an address
    # and still have separate limits.
    local dup
    dup="$("$DETECT" duplicate-of "$id" 2>/dev/null)" || dup=""
    if [ -n "$dup" ]; then
        warn "'$id' signed in as $email — that is '$dup' again, which shares its limit."
        rollback_add "$id" "$created" "$dir"
        die "nothing added. Use a private browser window and sign in with your other account: cc add $id --email <address>"
    fi
    good "'$id' added as $email — cc moves to it when another account runs out (cc use $id to start on it)"
    cmd_status
}

# Sign a new account in. `claude auth login` does only that and exits; a build without
# the `auth` subcommand gets an interactive session to sign in and then exit.
login_account() {
    local id="$1" dir="$2" want="$3" known
    # The browser signs in with whichever claude.ai account it already has open — which
    # is how a "new" account silently turns out to be one already registered. Say so
    # before the browser opens, not after the login is wasted.
    known="$("$DETECT" emails 2>/dev/null | awk -F'\t' -v me="$id" \
        '$1 != me && $2 != "" { printf "%s%s (%s)", sep, $1, $2; sep = ", " }')"
    [ -n "$known" ] && note "already added: $known"
    warn "your browser signs in with whichever claude.ai account is open — if that is one above, use a private window"

    if env CLAUDE_CONFIG_DIR="$dir" claude auth --help >/dev/null 2>&1; then
        if [ -n "$want" ]; then
            note "opening login as ${want}…"
            env CLAUDE_CONFIG_DIR="$dir" claude auth login --email "$want" || true
        else
            note "opening login…"
            env CLAUDE_CONFIG_DIR="$dir" claude auth login || true
        fi
    else
        note "opening Claude — sign in, then exit it"
        env CLAUDE_CONFIG_DIR="$dir" claude || true
    fi
}

# Undo a registration whose login did not produce a usable, distinct account.
rollback_add() {
    local id="$1" created="$2" dir="$3"
    python3 - "$id" <<'PY'
import json, os, sys
CONFIG = os.path.join(os.path.expanduser("~"), ".claude-switch", "config.json")
cfg = json.load(open(CONFIG))
cfg["accounts"] = [a for a in cfg["accounts"] if a["id"] != sys.argv[1]]
tmp = CONFIG + ".tmp"
json.dump(cfg, open(tmp, "w"), indent=2); os.chmod(tmp, 0o600); os.replace(tmp, CONFIG)
PY
    [ "$created" = "1" ] && rm -rf "$dir" && note "removed $dir"
}

# ---- cc remove --------------------------------------------------------------
cmd_remove() {
    local id="${1:-}" purge=0
    [ -n "$id" ] || die "usage: cc remove <id> [--purge]"
    shift
    [ "${1:-}" = "--purge" ] && purge=1
    is_default "$id" && die "cc remove: refusing — '$id' is the default account"
    if "$DETECT" pins | awk -F'\t' -v id="$id" '$2 == id || $4 == id { found = 1 } END { exit !found }'; then
        die "cc remove: '$id' is used by a pinned folder — see cc pins, then cc unpin it first"
    fi
    local dir; dir="$(acct_dir "$id")" || die "no such account: $id"

    if [ "$purge" = "1" ]; then
        warn "--purge deletes $dir, including that account's local credentials and history."
        warn "The account upstream is unaffected. This cannot be undone."
        printf '%sType the account id to confirm:%s ' "$c_bold" "$c_rst" >&2
        local typed; read -r typed
        [ "$typed" = "$id" ] || die "cc remove: confirmation did not match — nothing removed"
    fi

    python3 - "$id" <<'PY'
import json, os, sys
CONFIG = os.path.join(os.path.expanduser("~"), ".claude-switch", "config.json")
cfg = json.load(open(CONFIG))
cfg["accounts"] = [a for a in cfg["accounts"] if a["id"] != sys.argv[1]]
tmp = CONFIG + ".tmp"
json.dump(cfg, open(tmp, "w"), indent=2); os.chmod(tmp, 0o600); os.replace(tmp, CONFIG)
PY
    good "deregistered '$id'"
    if [ "$purge" = "1" ]; then
        rm -rf "$dir" && good "deleted $dir"
    else
        note "directory left in place: $dir"
    fi
}

# ---- fallback tiers ---------------------------------------------------------
# Tier 2: pay-per-token API key. Off unless configured, and confirmed each use by
# default — an unattended fallback into this can spend real money.
try_api_key() {
    local session="$1" resume="$2"
    "$DETECT" fallback apiKey enabled >/dev/null 2>&1 || return 1
    local keycmd; keycmd="$("$DETECT" fallback apiKey keyCommand 2>/dev/null)" || return 1
    [ -n "$keycmd" ] || return 1

    local key; key="$(eval "$keycmd" 2>/dev/null)"
    [ -n "$key" ] || { warn "apiKey.keyCommand produced nothing — skipping"; return 1; }

    if "$DETECT" fallback apiKey confirmEachUse >/dev/null 2>&1; then
        warn "All accounts are limited. The API key tier bills PER TOKEN against an"
        warn "account with no subscription cap. This can cost real money."
        printf '%sContinue on the API key? [y/N]%s ' "$c_bold" "$c_rst" >&2
        local ans; read -r ans
        case "$ans" in [yY]*) ;; *) note "declined"; return 1 ;; esac
    fi

    good "falling back to the API key tier — same conversation"
    if [ "$resume" = "1" ]; then
        env -u CLAUDE_CONFIG_DIR ANTHROPIC_API_KEY="$key" claude --resume "$session"
    else
        env -u CLAUDE_CONFIG_DIR ANTHROPIC_API_KEY="$key" claude --session-id "$session"
    fi
    return 0
}

# Tier 3: a different tool entirely. No transcript translation is attempted —
# a silently lossy import is worse than an honest fresh start.
try_external() {
    local transcript="$1"
    "$DETECT" fallback externalCli enabled >/dev/null 2>&1 || return 1
    local cmd; cmd="$("$DETECT" fallback externalCli command 2>/dev/null)" || return 1
    [ -n "$cmd" ] || return 1
    command -v "${cmd%% *}" >/dev/null 2>&1 || { note "external CLI '${cmd%% *}' not installed — skipping"; return 1; }

    warn "Handing off to: $cmd"
    warn "This is a DIFFERENT tool. Your conversation does NOT carry over — it starts fresh."
    [ -n "$transcript" ] && note "transcript, if you want to carry anything by hand: $transcript"
    eval "$cmd"
    return 0
}

exhausted() {
    warn "every account is limited, and no fallback is available."
    # soonest exits non-zero when nothing is actually limited — report what we can
    # rather than printing a bogus epoch-0 reset time.
    local info
    if info="$("$DETECT" soonest 2>/dev/null)" && [ -n "$info" ]; then
        local aid="${info%% *}" until="${info##* }"
        if [ "${until:-0}" -gt 0 ] 2>/dev/null; then
            warn "'$aid' frees up first at $(fmt_time "$until")."
        fi
    fi
    exit 1
}

# ---- cc use / clear / help --------------------------------------------------
cmd_use() {
    local id="${1:-}"
    [ -n "$id" ] || die "usage: cc use <id>   (accounts: $("$DETECT" accounts | cut -f1 | tr '\n' ' '))"
    "$DETECT" use "$id" || exit $?
    good "new sessions start on '$id' while it has quota, and fail over as usual after that"
    [ -x "$VSCODE" ] && "$VSCODE" sync
    cmd_status
}

cmd_clear() {
    local id="${1:-}"
    [ -n "$id" ] || die "usage: cc clear <id>"
    "$DETECT" mark "$id" 0 || exit $?
    good "cleared the limit recorded for '$id'"
    sync_vscode
}

# ---- cc cloud ---------------------------------------------------------------
# Cloud sessions run on Anthropic's servers against a GitHub repo and draw on the
# account's cloud session credit first, so they go to one fixed account — the one
# holding the credit — even while its local 5-hour or weekly window is exhausted.
cloud_account() {
    python3 - <<'PY' 2>/dev/null
import json, os
cfg = json.load(open(os.path.expanduser("~/.claude-switch/config.json")))
print((cfg.get("cloud") or {}).get("account") or "")
PY
}

cmd_cloud() {
    local id=""
    if [ "${1:-}" = "set" ]; then
        id="${2:-}"
        [ -n "$id" ] || die "usage: cc cloud set <id>"
        acct_dir "$id" >/dev/null || die "no account '$id' — see \`cc status\`"
        python3 - "$id" <<'PY' || exit 1
import json, os, sys
CONFIG = os.path.expanduser("~/.claude-switch/config.json")
cfg = json.load(open(CONFIG))
cfg.setdefault("cloud", {})["account"] = sys.argv[1]
tmp = CONFIG + ".tmp"
json.dump(cfg, open(tmp, "w"), indent=2); os.chmod(tmp, 0o600); os.replace(tmp, CONFIG)
PY
        good "cloud sessions now start on $(acct_label "$id")"
        return 0
    fi
    if [ "${1:-}" = "--acct" ]; then
        { [ $# -ge 2 ] && [ -n "$2" ]; } || die "cc cloud: --acct needs a value"
        id="$2"; shift 2
    fi
    [ -n "$id" ] || id="$(cloud_account)"
    [ -n "$id" ] || die "no cloud account set — run: cc cloud set <id>   (the account holding the cloud credit)"
    acct_dir "$id" >/dev/null || die "no account '$id' — see \`cc status\`"
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 \
        || warn "$PWD is not a git repo — a cloud session needs a GitHub repo to work on"
    note "cloud session on $(acct_label "$id")"
    run_acct "$id" --cloud "$@"
}

usage() { sed -n 's/^#   \(cc .*\)/  \1/p' "${BASH_SOURCE[0]}"; }

# ---- argument parsing -------------------------------------------------------
case "${1:-}" in
    status) cmd_status; exit $? ;;
    refresh) shift; cmd_refresh "$@"; exit $? ;;
    add)    shift; cmd_add "$@"; exit $? ;;
    remove) shift; cmd_remove "$@"; exit $? ;;
    use)    shift; cmd_use "$@"; exit $? ;;
    clear)  shift; cmd_clear "$@"; exit $? ;;
    pin)    shift; cmd_pin "$@"; exit $? ;;
    unpin)  shift; cmd_unpin "$@"; exit $? ;;
    pins)   shift; cmd_pins; exit $? ;;
    adopt)  shift; cmd_adopt "$@"; exit $? ;;
    cloud)  shift; cmd_cloud "$@"; exit $? ;;
    vscode)
        shift
        [ -x "$VSCODE" ] || die "missing $VSCODE"
        [ $# -gt 0 ] || set -- status
        exec "$VSCODE" "$@" ;;
    help|-h|--help) usage; exit 0 ;;
    [a-z]*)
        # A bare word used to fall through to claude as the first prompt, on
        # whichever account happened to be free — `cc use third` did exactly that
        # before `use` existed. Refuse it instead.
        die "unknown command: $1 — see \`cc help\`. To hand claude a prompt: cc -- \"$*\"" ;;
esac

FORCED=""
while :; do
    case "${1:-}" in
        --acct)   FORCED="${2:-}"; shift 2 ;;
        --manual) AUTOKILL=0; shift ;;
        --no-auto-continue) AUTO_CONTINUE=0; shift ;;
        --)       shift; break ;;
        *) break ;;
    esac
done

"$DETECT" accounts >/dev/null || exit 3   # surfaces config errors before launching

# Several cc sessions can run at once, on one account or many. Each keeps its own
# session id, watcher and run files; the only shared files (state, pins, usage) are
# written under a lock or by atomic replace, so sessions never wait on each other.
SESSION="$(new_session)"
CWD="$PWD"
RESUME=0
CONTINUE_MSG=""
PIN_ACCT=""
if pin="$("$DETECT" pin-of "$CWD" 2>/dev/null)"; then
    PIN_ACCT="$(printf '%s' "$pin" | cut -f2)"
    # Chats of this folder made before it was pinned, so /resume finds them. Bounded
    # and silent: it only adds links, so a slow disk never holds the launch up.
    [ -x "$VSCODE" ] && "$VSCODE" adopt --folder "${pin%%$'\t'*}" --quick --quiet </dev/null >/dev/null 2>&1
fi
# Accounts already used in this run, space-delimited. A plain string rather than
# an associative array because macOS ships bash 3.2, which has no `declare -A`.
# Account ids are restricted to [a-z0-9_-], so they can never contain a space.
TRIED=""

if "$DETECT" get earlySwitch.enabled >/dev/null 2>&1; then EARLY=1; else EARLY=0; fi
if [ "$AUTO_CONTINUE" = "1" ] && ! "$DETECT" get autoContinue.enabled true >/dev/null 2>&1; then
    AUTO_CONTINUE=0
fi

# A pinned folder whose account is limited and that allows nothing else. The
# conversation is safe in that account's folder; it simply waits for the reset.
stop_pinned() {
    local id="$1" until
    until="$("$DETECT" until "$id" 2>/dev/null)" || until=0
    if [ "${until:-0}" -gt "$(date +%s)" ] 2>/dev/null; then
        warn "'$id' is limited until $(fmt_time "$until"), and this folder is pinned to it with nothing else allowed."
    else
        warn "'$id' is limited, and this folder is pinned to it with nothing else allowed."
    fi
    if [ "$RESUME" = "1" ] || [ -n "$TRIED" ]; then
        note "after the reset, run cc here and use /resume to pick this conversation up ($SESSION)"
    fi
    exit 1
}

# A pin set to ask: ask on a terminal, and treat no terminal as "stop".
ask_fallback() {
    local from="$1" to="$2"
    if [ ! -t 0 ] && [ -z "${CC_NUMBERED_MENUS:-}" ]; then
        note "this folder asks before moving off '$from', and there is no terminal to ask on"
        return 1
    fi
    menu "'$from' is limited. Continue on '$to'?" 0 "Switch to $to" "Stop and wait for the reset" || return 1
    [ "$MENU_PICK" -eq 0 ]
}

clean_run_files() { rm -f "$RUN_DIR/$SESSION".turn "$RUN_DIR/$SESSION".next "$RUN_DIR/$SESSION".settings.json "$RUN_DIR/$SESSION".early; }
trap clean_run_files EXIT

# Where this session starts: the pin's account, its fallback, or the global rotation.
decision="$("$DETECT" start-for "$CWD" "$FORCED")" || exit 3
verb="${decision%% *}"; ACCT="${decision#"$verb"}"; ACCT="${ACCT# }"
case "$verb" in
    use) ;;
    switch) warn "'$PIN_ACCT' is limited — this folder falls back to '$ACCT'" ;;
    ask) ask_fallback "$PIN_ACCT" "$ACCT" || stop_pinned "$PIN_ACCT" ;;
    stop) stop_pinned "$ACCT" ;;
    *) ACCT="" ;;
esac

# ---- main loop --------------------------------------------------------------
while :; do
    if [ -z "$ACCT" ]; then
        # Tier 1 exhausted. Try the configured fallbacks, in order. Only reached outside
        # pinned folders: a pin names everything its folder may use.
        slug="$("$DETECT" slug "$CWD")"
        last_transcript=""
        for d in $("$DETECT" accounts | cut -f2); do
            [ -f "$d/projects/$slug/$SESSION.jsonl" ] && last_transcript="$d/projects/$slug/$SESSION.jsonl"
        done
        try_api_key "$SESSION" "$RESUME" && exit 0
        try_external "$last_transcript" && exit 0
        exhausted
    fi

    dir="$(acct_dir "$ACCT")" || die "no such account: $ACCT"
    TRIED="$TRIED $ACCT"
    note "$(acct_label "$ACCT")"

    # Where the transcript already ends, so the scan below sees only what THIS run
    # appends. After a handoff the copied transcript still holds the previous
    # account's 429; without this the new account re-reads it and marks itself
    # limited.
    offset="$("$DETECT" size "$dir" "$SESSION" "$CWD")"

    # Early switch (opt-in): a status line of ours records the account's usage, and a
    # Stop hook marks the end of each turn, so the watcher can end the run between
    # turns once usage passes the threshold. Nothing is sent anywhere.
    extra=()
    rm -f "$RUN_DIR/$SESSION.turn" "$RUN_DIR/$SESSION.early"
    if [ "$EARLY" = "1" ]; then
        if settings="$("$DETECT" early-settings "$ACCT" "$SESSION" "$CWD")"; then
            extra=(--settings "$settings")
        fi
    fi

    WATCHER=""
    if [ "$AUTOKILL" = "1" ] && [ -x "$WATCH" ]; then
        CC_EARLY_SWITCH="$EARLY" "$WATCH" "$dir" "$SESSION" "$CWD" "$offset" "$$" "$ACCT" &
        WATCHER=$!
    fi

    # Pin this run to its account, so a limit it hits is attributed correctly even
    # after the conversation moves on. CC_MANAGED tells the plugin's hooks that
    # exiting is enough: this launcher carries the conversation from there.
    "$DETECT" record-run "$ACCT" "$SESSION" >/dev/null 2>&1 || true
    export CC_MANAGED=1

    # ${extra[@]+...}: bash 3.2 treats an empty array as unset under set -u.
    if [ "$RESUME" = "1" ] && [ -n "$CONTINUE_MSG" ]; then
        run_acct "$ACCT" --resume "$SESSION" ${extra[@]+"${extra[@]}"} "$@" "$CONTINUE_MSG"
    elif [ "$RESUME" = "1" ]; then
        run_acct "$ACCT" --resume "$SESSION" ${extra[@]+"${extra[@]}"} "$@"
    else
        run_acct "$ACCT" --session-id "$SESSION" ${extra[@]+"${extra[@]}"} "$@"
    fi

    if [ -n "$WATCHER" ]; then
        kill "$WATCHER" 2>/dev/null
        wait "$WATCHER" 2>/dev/null
    fi

    # A real limit cut the turn short; an early switch waited for the turn to end.
    reason=limit
    hit="$("$DETECT" scan "$dir" "$SESSION" "$CWD" "$offset")" || hit=""
    if [ -z "$hit" ] && [ -s "$RUN_DIR/$SESSION.early" ]; then
        hit="$(cat "$RUN_DIR/$SESSION.early")"
        reason=early
    fi
    [ -n "$hit" ] || exit 0               # normal exit — nothing to do
    read -r resets ltype <<<"$hit"

    "$DETECT" raise "$ACCT" "$resets" ${ltype:+"$ltype"} >/dev/null
    if [ "$reason" = "early" ]; then
        warn "$ACCT is nearly at its limit · resets $(fmt_time "$resets") — switching between turns"
    else
        warn "$ACCT hit its limit · resets $(fmt_time "$resets")"
    fi
    sync_vscode                           # the panel follows, when it is managed

    # Where to go next: the pin's fallback in a pinned folder, else the next free
    # unpinned account this run has not used yet.
    decision="$("$DETECT" fallback-for "$CWD" "$ACCT" "$(echo "$TRIED" | tr -s ' ' ',' | sed 's/^,//;s/,$//')")" \
        || decision="stop $ACCT"
    verb="${decision%% *}"; NEXT="${decision#"$verb"}"; NEXT="${NEXT# }"
    case "$verb" in
        switch) ;;
        ask) ask_fallback "$ACCT" "$NEXT" || stop_pinned "$ACCT" ;;
        stop) RESUME=1; stop_pinned "$NEXT" ;;
        *) ACCT=""; continue ;;            # fall through to the fallback tiers
    esac

    # ---- carry the conversation across --------------------------------------
    slug="$("$DETECT" slug "$CWD")"
    src="$dir/projects/$slug/$SESSION.jsonl"
    dst_dir="$(acct_dir "$NEXT")/projects/$slug"
    if [ -f "$src" ]; then
        mkdir -p "$dst_dir"
        note "carrying the conversation over ($(du -h "$src" | cut -f1))…"
        # already one file when VS Code sync has linked this chat across
        [ "$src" -ef "$dst_dir/$SESSION.jsonl" ] || cp -p "$src" "$dst_dir/$SESSION.jsonl"
        RESUME=1
        # The limit cut a turn short, so nobody is about to type: say "carry on" for
        # them. After an early switch the turn had finished and Claude waits for you.
        CONTINUE_MSG=""
        if [ "$reason" = "limit" ] && [ "$AUTO_CONTINUE" = "1" ]; then
            CONTINUE_MSG="$("$DETECT" get autoContinue.message 2>/dev/null)" || CONTINUE_MSG=""
            [ -n "$CONTINUE_MSG" ] || CONTINUE_MSG="Continue where you left off."
        fi
    else
        warn "no transcript found — starting fresh on $NEXT"
        SESSION="$(new_session)"
        RESUME=0
        CONTINUE_MSG=""
    fi

    ACCT="$NEXT"
    if [ -n "$CONTINUE_MSG" ]; then
        good "switching to $ACCT — same conversation, continuing by itself"
    else
        good "switching to $ACCT — same conversation"
    fi
done
