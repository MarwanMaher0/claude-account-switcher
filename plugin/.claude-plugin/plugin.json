{
  "$schema": "https://anthropic.com/claude-code/plugin.schema.json",
  "name": "cc-switch",
  "version": "2.1.0",
  "description": "Run several Claude Code accounts side by side and fail over when one hits its rate limit. Records limits the moment they land, moves the VS Code panel to a free account, and tells you how to continue.",
  "author": {
    "name": "Marwan Maher",
    "email": "marwanmaher635@gmail.com",
    "url": "https://github.com/MarwanMaher0"
  },
  "homepage": "https://github.com/MarwanMaher0/claude-account-switcher",
  "license": "MIT",
  "skills": ["./"],
  "commands": "./commands",
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume",
        "hooks": [{ "type": "command",
                    "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
                    "timeout": 10,
                    "statusMessage": "Checking account limits..." }] }
    ],
    "StopFailure": [
      { "matcher": "rate_limit",
        "hooks": [{ "type": "command",
                    "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/limit-hit.sh\"",
                    "timeout": 30 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command",
                    "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/limit-notice.sh\"",
                    "timeout": 15 }] }
    ]
  }
}
