{
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:claudeVSCodePanel"
  ],
  "extension": "Anthropic.claude-code",
  "markers": {
    "child env from {...process.env}": true,
    "reads claudeProcessWrapper": true,
    "reads process.env.CLAUDE_CONFIG_DIR": true,
    "viaProcessWrapper": true,
    "wrapper argv: [bundled binary] or []": true
  },
  "notes": {
    "terminal mode runs plain claude": true
  },
  "settings": {
    "claudeCode.claudeProcessWrapper": {
      "scope": "machine",
      "type": "string"
    },
    "claudeCode.environmentVariables": {
      "scope": "machine",
      "type": "array"
    },
    "claudeCode.useTerminal": {
      "scope": null,
      "type": "boolean"
    }
  },
  "version": "2.1.289",
  "views": [
    "claudeVSCodeSessionsList",
    "claudeVSCodeSidebar",
    "claudeVSCodeSidebarSecondary"
  ]
}
