---
import type { Locale } from '../data/faq'
import { faqs } from '../data/faq'
import { landingCopy } from '../data/landing-copy'
import facts from '../generated/facts.json'
import { base, repo } from '../../site.config.mjs'
import Icon from './Icon.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const c = landingCopy[locale]
const faq = faqs[locale]
const isAr = locale === 'ar'
const home = isAr ? `${base}ar/` : base
const otherHome = isAr ? base : `${base}ar/`
const docs = (path: string) => `${base}${path}`
const fill = (s: string) => s.replace('{tests}', String(facts.tests)).replace('{version}', String(facts.version))
const lines = (s: string) => s.split('\n')
const accountTone: Record<string, string> = { acme: 'violet', globex: 'rose', personal: 'brand' }
---

<header class="site-header" id="top">
  <div class="wrap header-row">
    <a class="brand" href={home} aria-label={`cc-switch, ${isAr ? 'الصفحة الرئيسية' : 'home'}`}>
      <span class="brand-mark" aria-hidden="true"><Icon name="logo" /></span>
      <span class="brand-name">cc-switch</span>
      <span class="brand-version">v{facts.version}</span>
    </a>
    <nav class="site-nav" aria-label={isAr ? 'التنقل الرئيسي' : 'Primary'}>
      <button type="button" class="nav-burger" id="nav-toggle" aria-expanded="false" aria-controls="nav-list" aria-label={c.nav.menu}>
        <span aria-hidden="true"></span>
      </button>
      <ul class="nav-list" id="nav-list">
        <li><a href="#why">{c.nav.why}</a></li>
        <li><a href="#features">{c.nav.features}</a></li>
        <li><a href="#start">{c.nav.start}</a></li>
        <li><a href="#faq">{c.nav.faq}</a></li>
        <li><a href={docs('docs/')} class="nav-docs">{c.nav.docs}</a></li>
      </ul>
    </nav>
    <div class="header-tools">
      <a class="tool-link" href={otherHome} hreflang={isAr ? 'en' : 'ar'} lang={isAr ? 'en' : 'ar'} dir={isAr ? 'ltr' : 'rtl'}>{c.nav.language}</a>
      <button type="button" class="theme-toggle" data-theme-toggle aria-label={c.nav.theme} aria-pressed="false">
        <Icon name="sun" /><Icon name="moon" />
      </button>
      <a class="tool-link github" href={repo} rel="noopener" aria-label={c.nav.github}><Icon name="github" /><span>{c.nav.github}</span></a>
    </div>
  </div>
</header>

<main id="main">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{c.hero.eyebrow}</p>
        <h1>
          <span>{c.hero.headline[0]}</span>
          <span class="accent">{c.hero.headline[1]}</span>
        </h1>
        <p class="lede">{c.hero.summary}</p>
        <div class="cta-row">
          <a class="btn btn-primary" href="#start">{c.hero.primary}<Icon name="arrow" /></a>
          <a class="btn btn-ghost" href={docs('docs/separate-projects/')}>{c.hero.secondary}</a>
        </div>
        <p class="hero-note"><Icon name="shield" />{c.hero.note}</p>
      </div>

      <figure class="hero-visual" aria-label={c.hero.visualLabel} data-demo>
        <div class="demo-folders" role="tablist" aria-label={c.demo.title}>
          {c.demo.folders.map((f, i) => (
            <button
              type="button"
              role="tab"
              id={`demo-tab-${i}`}
              class:list={['demo-folder', { 'is-active': i === 0 }]}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`demo-panel-${i}`}
              tabindex={i === 0 ? 0 : -1}
              data-demo-tab={i}
            >
              <span class="folder-path" dir="ltr">{f.path}</span>
              <span class={`acct acct-${accountTone[f.account]}`}>
                <span class="acct-dot" aria-hidden="true"></span>{f.account}
              </span>
              <span class="folder-kind">{f.kind === 'pinned' ? <Icon name="pin" /> : null}{f.kind === 'pinned' ? (isAr ? 'مربوط' : 'pinned') : (isAr ? 'الافتراضي' : 'default')}</span>
              <span class="folder-limit">{f.onLimit}</span>
            </button>
          ))}
        </div>
        <div class="demo-terminal" dir="ltr">
          <div class="terminal-bar" aria-hidden="true"><span></span><span></span><span></span><em>cc</em></div>
          {c.demo.lines.map((l, i) => (
            <div
              role="tabpanel"
              id={`demo-panel-${i}`}
              aria-labelledby={`demo-tab-${i}`}
              class:list={['terminal-panel', { 'is-active': i === 0 }]}
              data-demo-panel={i}
              hidden={i !== 0}
            >
              <p class="t-prompt"><span class="t-cwd">{l.folder}</span> <span class="t-dollar">$</span> <span class="t-cmd">{l.command}</span></p>
              {l.output.map((o, j) => (
                <p class="t-out" style={`--i:${j}`}>{o}</p>
              ))}
            </div>
          ))}
        </div>
        <figcaption class="demo-caption">{c.demo.caption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="trust" aria-label={c.trust.intro}>
    <div class="wrap trust-row">
      <span class="trust-intro">{c.trust.intro}</span>
      <ul class="trust-list">
        {c.trust.items.map((t) => <li>{fill(t)}</li>)}
      </ul>
    </div>
  </section>

  <section class="problem" id="why">
    <div class="wrap">
      <p class="section-label">{c.problem.label}</p>
      <h2 class="section-title">{c.problem.title}</h2>
      <p class="section-text">{c.problem.text}</p>

      <div class="compare">
        <div class="compare-card before">
          <h3>{c.problem.before}</h3>
          <table class="compare-table">
            <tbody>
              {c.problem.beforeRows.map(([folder, acct]) => (
                <tr><td dir="ltr" class="mono">{folder}</td><td>{acct}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="compare-limit"><Icon name="x" />{c.problem.beforeLimit}</p>
        </div>
        <div class="compare-arrow" aria-hidden="true"><Icon name="arrow" /></div>
        <div class="compare-card after">
          <h3>{c.problem.after}</h3>
          <table class="compare-table">
            <tbody>
              {c.problem.afterRows.map(([folder, acct]) => {
                const name = acct.split(' ')[0]
                return (
                  <tr>
                    <td dir="ltr" class="mono">{folder}</td>
                    <td><span class={`acct acct-${accountTone[name] ?? 'brand'}`}><span class="acct-dot" aria-hidden="true"></span>{acct}</span></td>
                  </tr>
                )
              })}
            </tbody>
          </table>
          <p class="compare-limit good"><Icon name="check" />{c.problem.afterLimit}</p>
        </div>
      </div>

      <div class="rules">
        <h3>{c.problem.rulesTitle}</h3>
        <ol>
          {c.problem.rules.map((r) => <li>{r}</li>)}
        </ol>
      </div>
    </div>
  </section>

  <section class="features" id="features">
    <div class="wrap">
      <p class="section-label">{c.features.label}</p>
      <h2 class="section-title">{lines(c.features.title).map((l, i) => <Fragment>{i > 0 && <br />}{l}</Fragment>)}</h2>
      <p class="section-text">{c.features.text}</p>
      <ul class="feature-grid">
        {c.features.cards.map((f) => (
          <li class="feature">
            <span class="feature-icon" aria-hidden="true"><Icon name={f.icon} /></span>
            <h3><a href={docs(f.href)}>{f.title}</a></h3>
            <p>{f.text}</p>
            <code dir="ltr">{f.code}</code>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="start" id="start">
    <span id="try-it-without-installing" class="anchor-alias" aria-hidden="true"></span>
    <div class="wrap start-grid">
      <div class="start-intro">
        <p class="section-label">{c.start.label}</p>
        <h2 class="section-title">{lines(c.start.title).map((l, i) => <Fragment>{i > 0 && <br />}{l}</Fragment>)}</h2>
        <p class="section-text">{c.start.text}</p>
        <a class="text-link" href={docs('docs/get-started/')}>{c.start.fullGuide}<Icon name="arrow" /></a>

        <aside class="handoff">
          <h3>{c.start.handoffTitle}</h3>
          <ol>
            {c.start.handoff.map((h) => <li>{h}</li>)}
          </ol>
          <p>{c.start.handoffNote}</p>
        </aside>
      </div>
      <ol class="steps">
        {c.start.steps.map((s, i) => (
          <li class="step">
            <span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="step-body">
              <h3>{s.title}</h3>
              <p>{s.note}</p>
              <div class="codeblock" dir="ltr">
                <pre tabindex="0"><code>{s.code}</code></pre>
                <button type="button" class="copy-btn" data-copy data-copied={c.start.copied} data-fail={c.start.copyFail} aria-label={`${c.start.copy}: ${s.title}`}>
                  <Icon name="copy" /><span>{c.start.copy}</span>
                </button>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="who" id="who">
    <span id="is-this-for-you" class="anchor-alias" aria-hidden="true"></span>
    <div class="wrap">
      <p class="section-label">{c.who.label}</p>
      <h2 class="section-title">{lines(c.who.title).map((l, i) => <Fragment>{i > 0 && <br />}{l}</Fragment>)}</h2>
      <div class="who-grid">
        <ul class="cases">
          {c.who.cases.map((k) => (
            <li><h3>{k.title}</h3><p>{k.text}</p></li>
          ))}
        </ul>
        <aside class="not-for">
          <h3>{c.who.notTitle}</h3>
          <ul>
            {c.who.not.map((n) => <li>{n}</li>)}
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section class="faq" id="faq">
    <span id="good-to-know" class="anchor-alias" aria-hidden="true"></span>
    <div class="wrap faq-grid">
      <div class="faq-intro">
        <p class="section-label">{c.faq.label}</p>
        <h2 class="section-title">{c.faq.title}</h2>
        <p class="section-text">{c.faq.text}</p>
      </div>
      <div class="faq-list">
        {faq.map((f) => (
          <details class="faq-item" name="faq">
            <summary><span>{f.question}</span><Icon name="plus" /></summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="final">
    <div class="wrap final-card">
      <p class="section-label">{c.final.label}</p>
      <h2>{lines(c.final.title).map((l, i) => <Fragment>{i > 0 && <br />}{l}</Fragment>)}</h2>
      <p>{c.final.text}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={docs('docs/get-started/')}>{c.final.primary}<Icon name="arrow" /></a>
        <a class="btn btn-ghost" href={repo} rel="noopener"><Icon name="github" />{c.final.github}</a>
      </div>
    </div>
  </section>
</main>

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <a class="brand" href={home}><span class="brand-mark" aria-hidden="true"><Icon name="logo" /></span><span class="brand-name">cc-switch</span></a>
      <p>{c.footer.text}</p>
      <p class="footer-disclaimer">{c.footer.disclaimer}</p>
    </div>
    <nav class="footer-links" aria-label={isAr ? 'روابط التذييل' : 'Footer'}>
      <a href={docs('docs/')}>{c.footer.docs}</a>
      <a href={docs('docs/get-started/')}>{c.footer.start}</a>
      <a href={docs('docs/privacy/')}>{c.footer.privacy}</a>
      <a href={docs('docs/security/')}>{c.footer.security}</a>
      <a href={docs('docs/changelog/')}>{c.footer.changelog}</a>
      <a href={`${base}llms.txt`}>{c.footer.llms}</a>
      <a href={`${repo}/blob/main/LICENSE`} rel="noopener">{c.footer.license}</a>
      <a href={otherHome} hreflang={isAr ? 'en' : 'ar'} lang={isAr ? 'en' : 'ar'} dir={isAr ? 'ltr' : 'rtl'}>{c.footer.otherLanguage}</a>
    </nav>
  </div>
</footer>

<script>
  const root = document.documentElement
  const key = 'starlight-theme'

  function applyTheme(theme: 'light' | 'dark') {
    root.dataset.theme = theme
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => b.setAttribute('aria-pressed', String(theme === 'dark')))
  }
  applyTheme(root.dataset.theme === 'dark' ? 'dark' : 'light')
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark'
      applyTheme(next)
      try {
        localStorage.setItem(key, next)
      } catch {
        /* storage unavailable */
      }
    })
  })

  const nav = document.querySelector<HTMLElement>('.site-nav')
  const navToggle = document.querySelector<HTMLButtonElement>('.nav-burger')
  if (nav && navToggle) {
    const setOpen = (open: boolean, focus = false) => {
      nav.classList.toggle('is-open', open)
      navToggle.setAttribute('aria-expanded', String(open))
      if (focus) navToggle.focus()
    }
    navToggle.addEventListener('click', () => setOpen(!nav.classList.contains('is-open')))
    nav.addEventListener('click', (event) => {
      if ((event.target as Element).closest('.nav-list a')) setOpen(false)
    })
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && nav.classList.contains('is-open')) setOpen(false, true)
    })
    const desktop = window.matchMedia('(min-width: 861px)')
    desktop.addEventListener('change', (event) => {
      if (event.matches) setOpen(false)
    })
  }

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.querySelector('span')
    const original = label?.textContent ?? ''
    btn.addEventListener('click', async () => {
      const code = btn.parentElement?.querySelector('code')?.textContent ?? ''
      try {
        await navigator.clipboard.writeText(code)
        btn.classList.add('is-done')
        if (label) label.textContent = btn.dataset.copied ?? original
      } catch {
        if (label) label.textContent = btn.dataset.fail ?? original
      }
      window.setTimeout(() => {
        btn.classList.remove('is-done')
        if (label) label.textContent = original
      }, 1800)
    })
  })

  const demo = document.querySelector<HTMLElement>('[data-demo]')
  if (demo) {
    const tabs = Array.from(demo.querySelectorAll<HTMLButtonElement>('[data-demo-tab]'))
    const panels = Array.from(demo.querySelectorAll<HTMLElement>('[data-demo-panel]'))
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)')
    let current = 0
    let timer: number | undefined

    const show = (i: number, focus = false) => {
      current = i
      tabs.forEach((t, j) => {
        const on = j === i
        t.classList.toggle('is-active', on)
        t.setAttribute('aria-selected', String(on))
        t.tabIndex = on ? 0 : -1
      })
      panels.forEach((p, j) => {
        const on = j === i
        p.hidden = !on
        p.classList.toggle('is-active', on)
        if (on) {
          p.classList.remove('replay')
          void p.offsetWidth
          p.classList.add('replay')
        }
      })
      if (focus) tabs[i].focus()
    }
    const stop = () => {
      if (timer) window.clearInterval(timer)
      timer = undefined
      demo.classList.remove('is-auto')
    }
    const start = () => {
      if (reduce.matches || timer) return
      demo.classList.add('is-auto')
      timer = window.setInterval(() => show((current + 1) % tabs.length), 4200)
    }

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => {
        stop()
        show(i)
      })
      t.addEventListener('keydown', (e) => {
        const horizontal = e.key === 'ArrowRight' || e.key === 'ArrowLeft'
        const vertical = e.key === 'ArrowDown' || e.key === 'ArrowUp'
        if (!horizontal && !vertical && e.key !== 'Home' && e.key !== 'End') return
        e.preventDefault()
        stop()
        const rtl = root.dir === 'rtl'
        let n = i
        if (e.key === 'Home') n = 0
        else if (e.key === 'End') n = tabs.length - 1
        else {
          const forward = e.key === 'ArrowDown' || (e.key === 'ArrowRight') !== rtl
          n = (i + (forward ? 1 : tabs.length - 1)) % tabs.length
        }
        show(n, true)
      })
    })
    demo.addEventListener('pointerenter', stop)
    demo.addEventListener('focusin', stop)

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((en) => (en.isIntersecting ? start() : stop()))
      })
      io.observe(demo)
    } else {
      start()
    }
    reduce.addEventListener('change', () => (reduce.matches ? stop() : start()))
  }
</script>
